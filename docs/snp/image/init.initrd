#!/bin/sh
# /init of the measured initrd.
#
# Job: find the root filesystem image, map it through dm-verity with the
# parameters the (measured) kernel command line carries, mount it read-only,
# mount the config device (outside the measurement) read-only and noexec, mount
# the workload device (also outside it) read-only and exec-permitted, and hand
# over to the root filesystem's /sbin/init. Nothing else.
#
# Everything this script says goes to the serial console: it is the only
# place a guest with no general-purpose userspace can put diagnostics, and it
# is visible to the host by construction.
export PATH=/bin:/sbin

say() { echo "initrd: $*"; }
fail() { say "FATAL: $*"; say "halting"; while :; do sleep 3600; done; }

mount -t devtmpfs -o nosuid,noexec devtmpfs /dev || fail "mount /dev"
exec >/dev/console 2>&1
mount -t proc -o nosuid,nodev,noexec proc /proc || fail "mount /proc"
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys || fail "mount /sys"

ROOTHASH= SALT=- DATABLOCKS= HASHSTART=
for w in $(cat /proc/cmdline); do
  case "$w" in
    verity.roothash=*)   ROOTHASH="${w#*=}" ;;
    verity.salt=*)       SALT="${w#*=}" ;;
    verity.datablocks=*) DATABLOCKS="${w#*=}" ;;
    verity.hashstart=*)  HASHSTART="${w#*=}" ;;
  esac
done
[ -n "$ROOTHASH" ] && [ -n "$DATABLOCKS" ] && [ -n "$HASHSTART" ] \
  || fail "command line lacks verity.roothash/datablocks/hashstart"
say "verity root hash $ROOTHASH"

# Block devices are found by the virtio-blk serial the launch script sets,
# not by probe order.
find_disk() {
  for d in /sys/block/vd*; do
    [ -f "$d/serial" ] || continue
    [ "$(cat "$d/serial")" = "$1" ] && { echo "/dev/${d##*/}"; return 0; }
  done
  return 1
}
i=0
until ROOTDEV=$(find_disk attested-rootfs); do
  i=$((i+1)); [ $i -lt 50 ] || fail "no virtio-blk device with serial attested-rootfs"
  sleep 0.2
done
say "root filesystem image on $ROOTDEV"

insmod /lib/dm-bufio.ko  || fail "insmod dm-bufio"
insmod /lib/dm-verity.ko || fail "insmod dm-verity"
MINOR=$(veritymap root "$ROOTDEV" "$ROOTDEV" "$DATABLOCKS" "$HASHSTART" "$ROOTHASH" "$SALT") \
  || fail "dm-verity mapping"
i=0
until [ -b "/dev/dm-$MINOR" ]; do
  i=$((i+1)); [ $i -lt 50 ] || fail "/dev/dm-$MINOR never appeared"
  sleep 0.2
done
say "dm-verity mapping /dev/dm-$MINOR active (panic_on_corruption)"

mount -t squashfs -o ro /dev/dm-$MINOR /newroot || fail "mount verity root"
say "root filesystem mounted read-only"

# The config device carries the reference value set, its detached signature,
# the peer table and the provisioned certificate chain. It is outside the
# launch measurement, so it is mounted read-only and nothing on it can run.
if CFGDEV=$(find_disk attested-config); then
  if mount -t ext4 -o ro,noexec,nosuid,nodev "$CFGDEV" /newroot/config; then
    say "config device $CFGDEV mounted at /config (ro,noexec,nosuid,nodev)"
  else
    say "WARNING: config device $CFGDEV present but would not mount"
  fi
else
  say "WARNING: no config device (virtio-blk serial attested-config)"
fi

# The workload device carries one OCI bundle: config.json and the rootfs it
# names. It is outside the launch measurement exactly as the config device is,
# and unlike the config device this mount permits exec — which is the one
# interesting thing about it. The gofer that serves the bundle to the sandbox
# bind-mounts that rootfs and remounts it read-only without MS_NOEXEC, and a
# mount made inside a user namespace has that flag locked, so a remount omitting
# it is refused and a noexec source cannot be served at all
# (docs/snp/evidence/spike-s1-runsc-in-guest/E2/notes.md). Read-only is what
# keeps the root filesystem's rule satisfied with no exception: that rule
# constrains writable mounts, and this one is not writable.
#
# So what the measurement covers here is that runsc, the flag set /sbin/init
# launches it with and these mount options are in the image. What the disk
# carries is not measured and is not claimed to be.
#
# busybox mount takes `exec` as an option word, where it means the absence of
# MS_NOEXEC, and it is passed literally so that the intent is on the console.
# /proc/mounts will show this mount as ro,nosuid,nodev: there is no exec option
# to show, only the noexec that is not there.
#
# A missing or unmountable disk is one line and the boot continues: no workload
# is the ordinary case, and every scenario recorded before ticket 24 is that one.
if WLDEV=$(find_disk attested-workload); then
  if mount -t ext4 -o ro,exec,nosuid,nodev "$WLDEV" /newroot/workload; then
    say "workload device $WLDEV mounted at /workload (ro,exec,nosuid,nodev; not measured)"
  else
    say "WARNING: workload device present but would not mount; the boot continues without a workload"
  fi
else
  say "no workload device (virtio-blk serial attested-workload); the boot continues without a workload"
fi

mount --move /dev /newroot/dev || fail "move /dev"
umount /proc; umount /sys
say "switching root"
exec switch_root /newroot /sbin/init
