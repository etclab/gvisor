# Generated bazel lockfile.
/MODULE.bazel.lock
# Generated bazel symlinks.
/bazel-*
# Generated build event file.
/.build_events.json
# Generated repository.
/repo
/repo.key
# Generate webhook admission.
/test/kubernetes/gvisor-injection-admission-webhook.yaml
# clangd compilation database
/.cache/clangd
/compile_commands.json

# Agent scratch space (local markdown issue tracker)
.scratch/

# Built binaries beside their sources under docs/snp (build outputs, never committed)
/docs/snp/image/emit-refvals/emit-refvals
/docs/snp/image/report-evidence/report-evidence
/docs/snp/cloud/tdx/emit-tdx-refvals/emit-tdx-refvals

# Python bytecode from importing predict-rtmr2.py's helpers.
/docs/snp/cloud/tdx/__pycache__/

# Ticket 19 build outputs: disk and config-device images, and the initrd that
# goes inside one. The manifests, the documents and the consoles are the record;
# these are gigabytes of bytes a rebuild reproduces.
/docs/snp/evidence/ticket19/**/disk.raw
/docs/snp/evidence/ticket19/**/config.raw
/docs/snp/evidence/ticket19/**/initrd.img

# Ticket 24 build outputs, the same rule as ticket 19's with the workload device
# added: the disk, the config device, the workload device and the initrd that
# goes inside the boot image. The manifests, the documents and the consoles are
# the record; these are gigabytes of bytes a rebuild reproduces, and the
# workload device is not measured at all.
/docs/snp/evidence/ticket24/**/disk.raw
/docs/snp/evidence/ticket24/**/config.raw
/docs/snp/evidence/ticket24/**/workload.raw
/docs/snp/evidence/ticket24/**/initrd.img
