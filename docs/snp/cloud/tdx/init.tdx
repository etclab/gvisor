#!/bin/sh
# /init of the measured initrd, on a Google Cloud TDX VM (ticket 19).
#
# This is the whole guest. It is not a stepping stone to one: there is no
# switch_root here, no pivot, and Ubuntu's root filesystem — which is on the
# same disk, two partitions away — is never mounted and never runs a line. What
# the provider's image supplies is shim, grub and a kernel; everything above
# that is in the initrd grub measured into RTMR2 before it handed control over,
# and that is the whole of the difference between this file and
# docs/snp/image/init.initrd, which mapped a dm-verity root and switched into
# it. On SEV-SNP the firmware measures kernel, initrd and command line into the
# launch digest, so the initrd could afford to be a loader. Here grub is the
# measurer, and it measures whole files as it opens them
# (docs/tdx-rtmr2-prediction.md): an initrd that carried everything is measured
# in full, and a dm-verity root would add a second mechanism proving something
# the first already proves.
#
# So: the busybox that runs this script, the tunneld this script starts, the
# author's public key tunneld trusts and the kernel modules the provider left
# out of its kernel are all in here, all covered by one SHA-384 that a verifier
# can compute from the disk image without booting it.
#
# Everything this script says goes to the serial console. It is the only
# diagnostic surface a measured guest has (spec, user story 48), it is what
# `gcloud compute instances get-serial-port-output` returns, and every line is
# prefixed `initrd:` so that a transcript can be read apart from the kernel's
# own.
#
# What it does, in order, and why the order is the order:
#
#   1. kernel filesystems, so that everything after this can be observed
#   2. the modules Ubuntu's gcp kernel leaves out: the TDX guest driver (there
#      is no evidence without it), the NIC (there is no peer without it), and
#      nf_tables (there is no policy without it)
#   3. the egress ceiling, installed in the kernel from the constant compiled
#      into tunneld and read back out of the kernel, then printed
#   4. the config device, found and mounted read-only, noexec — it is outside
#      the measurement and nothing on it may run
#   5. the workload device, found and mounted read-only and exec-permitted at
#      /workload — outside the measurement too, and the only mount in this guest
#      that permits exec, which is the one interesting thing about it. Absent or
#      unmountable is a line and the boot goes on (ticket 24)
#   6. the network, from the addressing the config device carries — the address
#      is outside the measurement for the reason ticket 14 gave: two guests that
#      differed in a measured byte would be two images, and the claim this whole
#      design rests on is that they ran the same one
#   7. the egress proof: four or more attempts to reach what the ceiling
#      forbids, each one refused, on the console, before anything is trusted
#   8. the workload the device carried, if it carried one, under runsc in a user
#      namespace (ticket 24) -- or, when the config device carries a tunnel
#      table at /config/tunnel-table.json, the whole of ticket 25's adapter
#      order instead: tunneld first with a sandbox socket, the exit attached to
#      it, the page the exit will be asked for, and only then runsc carrying
#      --tunnel-socket and --tunnel-table, with ticket 26's two timing knobs
#      beside it
#   9. tunneld, unless step 8 has already started it and waited for it
#
# Step 3 is where it is, and that is ticket 22's doing. It used to sit after the
# network, because the rule set was generated from policy.json and could not be
# installed until the config device had been found, mounted and read. The
# ceiling is a constant in the measured binary now, so it goes in before there
# is an interface to filter — and the window in which a measured guest is
# running and unconstrained has length zero rather than "however long finding a
# disk takes".
#
# Steps 3 and 7 come before step 9 for the same reason: a guest that started
# tunneld first and constrained itself afterwards would be attested and
# unconstrained for exactly as long as the slowest thing in startup.
#
# Step 8 is between them for a third reason. The ceiling is in the kernel by
# then and the egress proof has just shown that it holds, so the workload runs
# with the guest already constrained; and it runs before tunneld, so nothing it
# does can be mistaken for something a peer was talking to.
#
# Ticket 25 trades the second half of that away, and only when the config device
# asks for it. A sandbox on the adapter has no network of its own and its only
# way out is the socket tunneld serves, so on that path tunneld exists before the
# workload and the link is up while the workload runs. What replaces "nothing it
# does can be mistaken for something a peer was talking to" is stronger and is
# the claim ticket 25 and ticket 26 are about: the workload has no interface, no
# address and no route, every byte it sends leaves through a name the measured
# table permitted to a peer the signed set admitted, and ticket 26 adds that it
# leaves under a policy the peer pushed and the sentry judged a subset of that
# table. Without that file this script is ticket 24's, line for line.
#
# Ticket 26 adds no check to this file. docs/snp/image/init.rootfs walks
# /proc/mounts before anything else and powers the guest off if any writable
# mount is executable; there has never been a counterpart here, so on this
# vendor runsc still runs with a writable, executable / underneath it
# (docs/runsc-in-the-guest.md, leftover 1). That asymmetry is recorded and is
# deliberately not closed by this ticket: adding the rule here would be a change
# to what a TDX guest refuses to boot with, which is a decision about the
# measured image and not about a policy the sandbox honours.
export PATH=/bin:/sbin:/usr/bin

say() { echo "initrd: $*"; }
# The boot clock, from /proc/uptime with the shell's own read: no applet, no
# date(1), and the kernel's printk timestamps on the console lines around it say
# the same thing independently. Printed at the egress proof, on either side of
# the workload, and at tunneld — which is what a boot-time cost is measured from
# (docs/snp/image/init.rootfs has the same helper for the same reason).
uptime_say() { read UP _ < /proc/uptime; say "uptime ${UP}s"; }
fail() {
	say "FATAL: $*"
	say "halting; nothing further runs in this guest"
	sync
	while :; do sleep 3600; done
}

mount -t devtmpfs -o nosuid,noexec devtmpfs /dev || fail "mount /dev"
exec >/dev/console 2>&1
mount -t proc   -o nosuid,nodev,noexec proc   /proc || fail "mount /proc"
mount -t sysfs  -o nosuid,nodev,noexec sysfs  /sys  || fail "mount /sys"
mount -t tmpfs  -o nosuid,nodev,noexec,mode=755  tmpfs /run || fail "mount /run"
mount -t tmpfs  -o nosuid,nodev,noexec,mode=1777 tmpfs /tmp || fail "mount /tmp"
mount -t configfs -o nosuid,nodev,noexec configfs /sys/kernel/config || fail "mount configfs"

say "======== attested tunnel guest, in the initrd grub measured ========"
say "kernel  $(uname -r) $(uname -m)"
say "cmdline $(cat /proc/cmdline)"
dmesg | grep -iE 'tdx|memory encryption' | sed 's/^/initrd: dmesg: /'

# ---- 2. the modules the provider's kernel leaves out ----------------------
# Every one of these was taken out of the pinned Ubuntu image's own
# /lib/modules by the build (build-tdx-image.sh), never off the build host: a
# module built for another kernel would not load, and a module from another
# kernel is not what a verifier reading this image would find. They are
# decompressed at build time because busybox's insmod does not speak zstd.
#
# Order is dependency order, because there is no modprobe here and nothing
# resolves it for us.
for m in tdx-guest gve nf_tables nf_reject_ipv4 nf_reject_ipv6 nft_reject nft_reject_inet; do
	if [ ! -f "/lib/modules/$m.ko" ]; then
		say "module $m.ko is not in this initrd"
		continue
	fi
	if insmod "/lib/modules/$m.ko"; then
		say "loaded $m"
	else
		say "WARNING: $m did not load"
	fi
done
say "modules now resident: $(cut -d' ' -f1 /proc/modules | sort | tr '\n' ' ')"

# The report interface is what evidence comes out of. tsm_report is built into
# this kernel and the vendor driver is the module just loaded; if the directory
# is missing, tunneld will say so in its own words, but saying it here names
# the cause rather than the symptom.
if [ -d /sys/kernel/config/tsm/report ]; then
	say "report interface present at /sys/kernel/config/tsm/report"
else
	say "WARNING: /sys/kernel/config/tsm/report is absent; this guest has no evidence to present"
fi

# ---- 3. the egress ceiling ------------------------------------------------
# Before the config device, before the link, before anything in this guest can
# address a packet. The rule set is a constant inside tunneld and inside the
# measurement with it (attest/ceiling, attest/cmd/tunneld/egress.go): it takes
# no argument, reads no file, and names no peer, so there is nothing here for
# the config device to contribute and nothing for it to widen. `-egress print`
# writes the same text, and its SHA-256 is the digest this guest presents to
# every peer it meets.
#
# It names the interface by name rather than by index, which is what lets it
# load now: an index is resolved when the rule is loaded and eth0 does not exist
# yet, while a name is compared when a packet arrives (ticket 22, spike E3).
#
# A ceiling that will not install is a guest that would run unconstrained, so
# this is fatal.
say "installing the egress ceiling this image carries, before the link is up:"
tunneld -egress install || fail "the egress ceiling would not install"

# ---- 4. the config device -------------------------------------------------
# Google attaches it as a second persistent disk with --device-name
# attested-config. Inside the guest that name is normally supplied by udev,
# which runs google_nvme_id and asks the namespace over an admin command; there
# is no udev here and there will not be one, so the device is found from what
# the kernel itself exposes. Both ways are tried and the inventory is printed
# either way, because which of them works is a fact about the provider that this
# transcript is the record of.
CONFIG_NAME=attested-config

say "block devices, as this kernel presents them with no udev running:"
for d in /sys/block/*; do
	n=${d##*/}
	case "$n" in loop*|ram*|dm-*) continue ;; esac
	ser=
	for f in "$d/serial" "$d/device/serial"; do
		[ -r "$f" ] && ser=$(tr -d ' \n' < "$f") && break
	done
	say "  /dev/$n sectors=$(cat "$d/size" 2>/dev/null) serial='$ser' wwid='$(cat "$d/wwid" 2>/dev/null)'"
	for p in "$d"/"$n"*; do
		[ -d "$p" ] && say "    partition ${p##*/} sectors=$(cat "$p/size" 2>/dev/null)"
	done
done
for c in /sys/class/nvme/*; do
	[ -r "$c/serial" ] || continue
	say "  nvme controller ${c##*/}: serial='$(tr -d ' \n' < "$c/serial")' model='$(tr -d ' \n' < "$c/model" 2>/dev/null)'"
done

# ext4_label prints the volume label of a whole-device ext4 filesystem, or
# fails if there is not one there. The superblock is at byte 1024; its magic is
# two bytes at +0x38 and its label sixteen bytes at +0x78. Reading it directly
# avoids depending on busybox's blkid having been compiled in, and it cannot
# match the boot disk, whose first sectors are a GPT.
ext4_label() {
	[ "$(dd if="$1" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')" = "53ef" ] || return 1
	dd if="$1" bs=1 skip=1144 count=16 2>/dev/null | tr -d '\0'
}

find_config_dev() {
	# (a) the device name, if the kernel exposes it as an NVMe serial.
	for d in /sys/block/*; do
		n=${d##*/}
		case "$n" in loop*|ram*|dm-*) continue ;; esac
		for f in "$d/serial" "$d/device/serial"; do
			[ -r "$f" ] || continue
			[ "$(tr -d ' \n' < "$f")" = "$CONFIG_NAME" ] && { CFGDEV=/dev/$n; CFGHOW="the NVMe serial"; return 0; }
		done
	done
	# (b) the filesystem label mkconfigdev-tdx.sh wrote, which is the same
	#     name. This is a weaker identifier and it does not need to be a
	#     stronger one: nothing on the config device is trusted, so the worst a
	#     misidentified device can do is fail to mount or fail to parse, and
	#     both of those stop the guest here rather than admitting anybody.
	for d in /sys/block/*; do
		n=${d##*/}
		case "$n" in loop*|ram*|dm-*) continue ;; esac
		l=$(ext4_label "/dev/$n") || continue
		[ "$l" = "$CONFIG_NAME" ] && { CFGDEV=/dev/$n; CFGHOW="the ext4 label"; return 0; }
	done
	return 1
}

CFGDEV= CFGHOW=
i=0
until find_config_dev; do
	i=$((i + 1))
	[ $i -lt 150 ] || fail "no block device is named $CONFIG_NAME, by serial or by label, after 30 seconds"
	sleep 0.2
done
say "config device $CFGDEV found by $CFGHOW"
mount -t ext4 -o ro,noexec,nosuid,nodev "$CFGDEV" /config \
	|| fail "config device $CFGDEV would not mount"
say "config device mounted at /config (ro,noexec,nosuid,nodev); it holds:"
find /config -type f | sort | while read -r f; do
	say "  ${f#/config/}  $(stat -c %s "$f") bytes  $(sha256sum "$f" | cut -c1-16)…"
done

# ---- 5. the workload device -----------------------------------------------
# One OCI bundle: config.json and the rootfs it names, built by
# mkworkloaddev-tdx.sh and attached as a third disk with --device-name
# attested-workload. It is outside the measurement exactly as the config device
# is, and unlike the config device this mount permits exec — which is the one
# interesting thing about it. The gofer that serves the bundle to the sandbox
# bind-mounts that rootfs and remounts it read-only without MS_NOEXEC, and a
# mount made inside a user namespace has that flag locked, so a remount omitting
# it is refused and a noexec source cannot be served at all
# (docs/snp/evidence/spike-s1-runsc-in-guest/E2/notes.md). Read-only is what
# keeps it harmless: it is not a writable executable path, so the rule
# docs/snp/image/init.rootfs enforces would have nothing to say about it.
#
# So what the measurement covers here is the runsc in this initrd, the flag set
# step 8 launches it with and these mount options. What the disk carries is not
# measured and is not claimed to be.
#
# busybox mount takes `exec` as an option word, where it means the absence of
# MS_NOEXEC, and it is passed literally so that the intent is on the console.
# /proc/mounts will show this mount as ro,nosuid,nodev: there is no exec option
# to show, only the noexec that is not there.
#
# A missing or unmountable disk is one line and the boot continues: no workload
# is the ordinary case, and every guest booted before ticket 24 is that one.
WORKLOAD_NAME=attested-workload
# The label is the truncated form on purpose. ext4 stores sixteen bytes of label
# and 'attested-workload' is seventeen characters, so mke2fs writes
# 'attested-workloa' and mkworkloaddev-tdx.sh says so. The NVMe serial carries
# the whole name, which is why it is tried first.
WORKLOAD_LABEL=attested-workloa

find_workload_dev() {
	# (a) the device name, if the kernel exposes it as an NVMe serial. Same
	#     shape as find_config_dev, and same reason: there is no udev here to
	#     turn --device-name into a path.
	for d in /sys/block/*; do
		n=${d##*/}
		case "$n" in loop*|ram*|dm-*) continue ;; esac
		for f in "$d/serial" "$d/device/serial"; do
			[ -r "$f" ] || continue
			[ "$(tr -d ' \n' < "$f")" = "$WORKLOAD_NAME" ] && { WLDEV=/dev/$n; WLHOW="the NVMe serial"; return 0; }
		done
	done
	# (b) the filesystem label, truncated to what ext4 could hold.
	for d in /sys/block/*; do
		n=${d##*/}
		case "$n" in loop*|ram*|dm-*) continue ;; esac
		l=$(ext4_label "/dev/$n") || continue
		[ "$l" = "$WORKLOAD_LABEL" ] && { WLDEV=/dev/$n; WLHOW="the ext4 label"; return 0; }
	done
	return 1
}

# A short bounded wait and then a line, never a failure: the config device's own
# loop has already waited for the kernel to enumerate its namespaces, so this
# should find the disk on the first pass, and if it does not the guest has no
# workload rather than a problem.
WLDEV= WLHOW=
i=0
until find_workload_dev; do
	i=$((i + 1))
	[ $i -lt 15 ] || break
	sleep 0.2
done
if [ -n "$WLDEV" ]; then
	if mount -t ext4 -o ro,exec,nosuid,nodev "$WLDEV" /workload; then
		say "workload device $WLDEV found by $WLHOW, mounted at /workload (ro,exec,nosuid,nodev; not measured); it holds:"
		find /workload -type f | sort | while read -r f; do
			say "  ${f#/workload/}  $(stat -c %s "$f") bytes  $(sha256sum "$f" | cut -c1-16)…"
		done
	else
		say "WARNING: workload device $WLDEV present but would not mount; the boot continues without a workload"
	fi
else
	say "no workload device (NVMe serial $WORKLOAD_NAME, ext4 label $WORKLOAD_LABEL); the boot continues without a workload"
fi

# ---- 6. the network -------------------------------------------------------
# The addressing arrives on the config device, in a file this script parses
# field by field rather than sources: nothing on that device may execute, and a
# shell that ran it would be doing exactly that. Each field is checked against
# the shape it must have before it reaches a command line.
NET_IF= NET_ADDR= NET_PREFIX= NET_GW= NET_MTU=
[ -f /config/network.conf ] || fail "/config/network.conf is absent; this guest has no address"
while IFS='=' read -r k v; do
	v=$(printf '%s' "$v" | tr -d ' \r\t')
	case "$k" in
	interface) NET_IF=$v ;;
	address) NET_ADDR=$v ;;
	prefix) NET_PREFIX=$v ;;
	gateway) NET_GW=$v ;;
	mtu) NET_MTU=$v ;;
	esac
done < /config/network.conf

if [ -z "$NET_IF" ]; then
	for l in /sys/class/net/*; do
		n=${l##*/}
		[ "$n" = lo ] && continue
		NET_IF=$n
		break
	done
	say "network.conf named no interface; using $NET_IF, the only one that is not loopback"
fi
case "$NET_IF" in '' | *[!a-zA-Z0-9_-]*) fail "network.conf: interface '$NET_IF' is not an interface name" ;; esac
case "$NET_ADDR" in '' | *[!0-9.]*) fail "network.conf: address '$NET_ADDR' is not a dotted quad" ;; esac
case "$NET_PREFIX" in '' | *[!0-9]*) fail "network.conf: prefix '$NET_PREFIX' is not a number" ;; esac
case "$NET_GW" in '' | *[!0-9.]*) fail "network.conf: gateway '$NET_GW' is not a dotted quad" ;; esac
case "$NET_MTU" in *[!0-9]*) fail "network.conf: mtu '$NET_MTU' is not a number" ;; esac

[ -d "/sys/class/net/$NET_IF" ] || fail "no interface $NET_IF; the NIC driver did not attach"

# Loopback up, and it is not a formality.
#
# There is no init system in this guest to do it, and a guest whose lo is down
# looks fine right up to the point where it does not. The egress rule set
# refuses what may not leave by making netfilter build a refusal — a TCP reset,
# or an ICMP "administratively prohibited" — addressed back at the local socket
# that tried. The kernel routes that refusal to one of the guest's own
# addresses, which means out through lo and straight back in. With lo down it
# is dropped on the way, connect() never learns anything, and the dial sits
# there until it times out: a transcript reading "timed out" would not have
# shown that a rule refused anything, because a black hole, a missing route and
# a firewall all look like that. This was measured rather than assumed — with
# lo down the TCP probes time out and with it up they are refused in
# microseconds.
ip link set lo up || fail "bringing loopback up"
say "loopback up (the kernel delivers a rule's refusal to the local socket over it)"

ip link set "$NET_IF" up || fail "bringing $NET_IF up"
[ -n "$NET_MTU" ] && { ip link set "$NET_IF" mtu "$NET_MTU" || fail "setting mtu $NET_MTU on $NET_IF"; }
ip addr add "$NET_ADDR/$NET_PREFIX" dev "$NET_IF" || fail "setting $NET_ADDR/$NET_PREFIX on $NET_IF"
# A /32 leaves the gateway off-link, which is how a Google VPC addresses a
# guest: a host route to the gateway first, then the default through it. There
# is no DHCP client here and there will not be one — a guest that learned its
# address from the network would be a guest whose address the network chose.
ip route add "$NET_GW" dev "$NET_IF" || fail "adding the on-link route to $NET_GW"
ip route add default via "$NET_GW" || fail "adding the default route via $NET_GW"
say "link $NET_IF up: $NET_ADDR/$NET_PREFIX mtu $(cat "/sys/class/net/$NET_IF/mtu"), gateway $NET_GW"
ip -o addr show | sed 's/^/initrd: addr: /'
ip route show | sed 's/^/initrd: route: /'

# ---- 7. the proof that it holds ------------------------------------------
# The ceiling went in at step 3, with no interface to filter; this is the first
# moment there is one, so this is where the proof belongs. The probe reads
# nothing either — the gateway is named on the command line because it is the
# one interesting address that is not universal, and it comes from the config
# device with the rest of the addressing.
say "proving the egress ceiling holds, from inside the guest:"
tunneld -egress probe -egress-probe "udp:$NET_GW:53,tcp:$NET_GW:80" \
	|| fail "the egress probe reached something the ceiling forbids"
uptime_say

# ---- 8. the workload, under runsc (tickets 24, 25 and 26) -----------------
# After the ceiling and after the proof that it holds, because a workload that
# ran before them would run in a guest that could still address a packet.
# Whether it also runs before tunneld is the question the two orders at the
# bottom of this file answer, and the answer is the config device's: with a
# tunnel table at /config/tunnel-table.json the workload is a sandbox on the
# adapter and tunneld has to exist before it (ticket 25), and without one
# nothing changes and this is ticket 24's script line for line.
#
# The bundle comes off the workload device mounted at /workload
# (ro,exec,nosuid,nodev) at step 5, which is outside the measurement. What is
# measured is this binary, this flag set and that mount's options — never what
# the disk carried.
#
# The namespace: runsc rootless wants a user namespace with a uid mapping it may
# write, and inside one it needs no host capability at all (spike S1, README's
# "Capabilities" section). busybox's unshare makes it — -U -r maps this init's
# root to root inside it, -m -n -p are the namespaces runsc builds on, and -f is
# needed because unsharing a PID namespace only takes effect for a child. The
# fresh procfs is for that new PID namespace: runsc re-execs /proc/self/exe and
# mounts by /proc/self/fd, and the /proc this init mounted belongs to the old
# one, so writing a child's uid_map through it looks up a pid in the wrong
# namespace and the gofer never starts (ticket 24, E1). It is mounted
# nosuid,nodev,noexec like every other writable mount here, and inside the mount
# namespace unshare made, so it is not in this init's table.
#
# --root is on /run, which is rw,noexec: the state directory holds a lock and
# metadata, runsc creates it itself, and --gofer-network-namespace=new is what
# keeps runsc from bind-mounting an nsfs rw into it (spike S1, E2 and E3).
#
# --network=none is what stands between this workload and a link that is, unlike
# the SNP guest's at this point in its boot, already up. On the adapter path it
# is also what makes the adapter the sandbox's only way out.
#
# Ticket 26 adds nothing to the flag set. --tunnel-socket and --tunnel-table are
# ticket 25's and they are the whole of the adapter; what ticket 26 pushes over
# the contract narrows the table the sentry already holds, and no flag says so.
#
# The root is the one thing this vendor needs and SEV-SNP does not. The sandbox
# and the gofer each pivot_root(2) on their way up
# (runsc/cmd/sandboxsetup/fs.go:32-53, the syscall at :45, reached from
# runsc/cmd/sentry/sentrycmd/chroot.go:181 and
# runsc/cmd/sandboxsetup/gofer_mount.go:260), and pivot_root cannot move a root
# mount that has no parent — the initramfs is the one mount in Linux with none,
# which is the whole reason switch_root exists. On SEV-SNP init.initrd has
# switch_root'ed into a squashfs long before this line, so the root there has a
# parent and this same flag set works untouched (ticket 24, E3); here the
# initramfs *is* the measured root and stays that way, so E4's boot got a sandbox
# that died on `pivot_root failed, make sure that the root mount has a parent`.
# What the namespace gets instead is a second view of that same tmpfs which does
# have one: a recursive bind under /run, moved to where / is, entered through the
# working directory that was pinned to it before the move — the only path that
# names that mount rather than the initramfs underneath it. Both steps carry
# weight and E5 booted each alone to find out: with the bind but no move, and
# with the move but no chroot, the kernel calls the process chrooted — current
# root against the namespace root followed down through whatever is mounted on it
# — and refuses the gofer's clone(CLONE_NEWUSER) with EPERM. The bind must be
# recursive; a plain one is refused, because / has mounts a user namespace has
# locked. Nothing is deleted, nothing is switched and nothing propagates out: the
# initramfs is still the root of this init's mount namespace and the table
# printed below is the table ticket 19 printed. mkdir and chroot are reached
# through /bin/busybox rather than through applet symlinks, so the initrd's file
# list is exactly what it was (build-tdx-image.sh's APPLETS) and the only thing
# ticket 24's fix changes in the measurement is this script. Ticket 26 keeps that
# rule and every applet it adds — httpd, wget, kill, wc, mkdir, dd, tail, cp — is
# reached the same way, so this ticket adds no cpio entry either.
#
# The rbind is also what puts the sandbox socket in reach. /run is bound
# recursively, and a bind is the same superblock, so /run/tunneld/sandbox.sock
# inside the chroot is the same socket inode tunneld created outside it. The
# helper runsc spawns dials it by that path, across the copied mount namespace
# and the fresh network namespace both — only an abstract socket is
# per-network-namespace, and this one is a pathname socket for exactly that
# reason (docs/the-adapter.md).
SANDBOX_SOCKET=/run/tunneld/sandbox.sock
TUNNEL_TABLE=/config/tunnel-table.json
EXIT_ALLOW=/config/exit-allow
RUNSC_DEBUG_DIR=/run/runsc-debug
RUNSC_FLAGS="--root=/run/runsc-state --platform=systrap --network=none --ignore-cgroups --rootless --gofer-network-namespace=new"
ADAPTER=0
if [ -f "$TUNNEL_TABLE" ]; then
	ADAPTER=1
	RUNSC_FLAGS="$RUNSC_FLAGS --tunnel-socket=$SANDBOX_SOCKET --tunnel-table=$TUNNEL_TABLE"
	# The sentry's own account of what it did, which is the only diagnostic
	# this guest has for the adapter. `tunnel dns:` for a name it resolved or
	# refused and `tunnel attach:` for a stream it asked tunneld for are
	# debug-level, so they exist only with --debug. They go to files under
	# /run rather than to the console, because --debug on a serial port is
	# tens of thousands of lines and would bury the workload's own output;
	# the adapter branch below picks those lines back out afterwards. /run is
	# rw,noexec and a log file is not an exec.
	RUNSC_FLAGS="$RUNSC_FLAGS --debug --debug-log=$RUNSC_DEBUG_DIR/"
fi
ROOT_WITH_A_PARENT="busybox mkdir -p /run/root; mount --rbind / /run/root; cd /run/root; mount --move . /"
RUNSC_CMD="/usr/bin/runsc $RUNSC_FLAGS run --bundle /workload workload"
WORKLOAD_SH="$ROOT_WITH_A_PARENT; exec busybox chroot . sh -c 'mount -t proc -o nosuid,nodev,noexec proc /proc; exec $RUNSC_CMD'"

# run_workload is ticket 24's block in a function, so that the two orders below
# both run exactly it and neither has a copy.
run_workload() {
	if [ -f /workload/config.json ]; then
		say "the workload device carries a bundle at /workload/config.json"
		say "running: unshare -Urmnpf sh -c \"$WORKLOAD_SH\""
		uptime_say
		unshare -Urmnpf sh -c "$WORKLOAD_SH"
		wrc=$?
		uptime_say
		say "workload exited with status $wrc"
	else
		say "no workload bundle at /workload/config.json; continuing to tunneld"
	fi
}

# A number off the config device, or nothing. The file is read rather than
# sourced and its contents are checked against the shape a number has before
# they reach a command line, exactly as network.conf's fields are: nothing on
# that device may execute and a shell that ran it would be doing that.
#
# Every knob these read is a TIMING knob and none of them is measured. What they
# move is when this script does something, never what it is allowed to do: the
# ceiling is compiled in, the flag set is above, and the policy the sandbox ends
# up under is decided by the peer that pushed it and by the sentry that judged
# the subset. A host that changed one of these numbers would change how long a
# recording lasts and nothing else, and a reader of the console can see the
# number this boot used because it is printed next to what it did.
knob() { # FILE
	[ -f "$1" ] || return 1
	v=$(cat "$1" 2>/dev/null | tr -d ' \r\n\t')
	case "$v" in '' | *[!0-9]*) say "WARNING: $1 is not a number ('$v'); ignoring it"; return 1 ;; esac
	[ "$v" != 0 ] || return 1
	printf '%s' "$v"
}

# A policy to push, if the config device carries one (ticket 22,
# docs/policy-push.md). The file is looked for rather than named
# unconditionally, because no policy is the ordinary case — it is what every
# scenario recorded before ticket 22 runs — and a tunneld handed a path it
# cannot read refuses to start.
#
# The name is deliberately not policy.json. That document and its signature are
# what ticket 22 took OFF the config device, and tunneld refuses to start on a
# device carrying either half of it. This is a different document with a
# different life: nothing here loads it, parses it or enforces it. It is handed
# to a peer over a tunnel that peer was already admitted on, and what makes it
# trustworthy there is the evidence this guest presented — not the disk it was
# read from, which is the host's and is not measured.
PUSH=
if [ -f /config/push-policy.json ]; then
	PUSH="-push-policy /config/push-policy.json"
	say "the config device carries a policy to push: /config/push-policy.json"
fi

# ---- ticket 26's two watchdogs, and what each one is for -------------------
#
# Both are background children of this script, both are started just before the
# workload, and both measure their delay from that moment. Neither is in the
# measurement's way: one starts a second tunneld, which is the same measured
# binary reading the same measured author key, and the other sends a signal.
#
# narrow_later starts a SECOND tunneld that pushes a narrower policy at the peer
# while the first one's tunnel is still carrying the sandbox's bytes. It is a
# second process rather than a restart of the first because a restart would take
# this guest's tunnel down with it, and the whole claim under test is that a
# policy can be replaced with the workload running. The two share this guest's
# documents through -config /config and differ in one file: -run names a second
# run configuration on the same device, whose `listen` is empty so that it binds
# no port the first tunneld holds (attest/cmd/tunneld/runconfig.go: an empty
# listen is the one the ceiling has no opinion about, and package tunneld takes
# 127.0.0.1:0 for it), and whose `exercise` names the peer to dial. The dial is
# what makes a push happen at all, and it opens its own socket — the ceiling
# grants udp/4433 outbound from any source port on eth0 and the reply back in on
# source port 4433, so this second tunneld reaches the peer under exactly the
# rules the first one does. Its exchange is expected to fail and says nothing:
# the push lands when the tunnel is established and before anything is sent over
# it, and what answers a stream on the far side is that guest's exit, which holds
# a list of destinations and will not find this payload in it.
narrow_later() { # SECONDS
	sleep "$1"
	say "narrow-after: ${1}s elapsed; starting a second tunneld to push /config/push-policy-narrow.json at the peer"
	uptime_say
	/usr/bin/tunneld -config /config -run /config/tunneld-narrow.json \
		-tdx-collateral-dir /config/collateral \
		-push-policy /config/push-policy-narrow.json &
	say "narrow-after: the second tunneld is pid $! (its lines say tunneld: like the first one's)"
}

# kill_later ends the workload's liveness the way a workload that died would.
# It kills the sandbox rather than asking it to stop: the point is that nothing
# inside cooperated. The sentry goes, the helper's link to it ends, the helper
# closes its tunneld client, and the tunneld beside it stops hearing the pulse
# that says which policy is in force — which is the contract's liveness rule and
# the reason ticket 23's "apply then ack" was not enough (DOCTRINE, ticket 26).
#
# Processes are found by name in this init's own /proc rather than by pid,
# because the workload runs behind `unshare -f`: the process this script would
# have a pid for is unshare, and the one that is init of the new PID namespace
# is its child. A PID namespace is visible from its parent, so every process the
# sandbox is made of is in this table under a pid of this namespace's; matching
# runsc's own comm reaches all of them, and unshare is killed after them so that
# the wait below returns.
kill_later() { # SECONDS
	sleep "$1"
	say "kill-after: ${1}s elapsed; killing the sandbox, so that nothing inside it gets to say goodbye"
	uptime_say
	k=0
	for p in /proc/[0-9]*; do
		pid=${p#/proc/}
		c=$(cat "$p/comm" 2>/dev/null) || continue
		case "$c" in
		runsc*) busybox kill -9 "$pid" 2>/dev/null && k=$((k + 1)) ;;
		esac
	done
	for p in /proc/[0-9]*; do
		pid=${p#/proc/}
		c=$(cat "$p/comm" 2>/dev/null) || continue
		case "$c" in
		unshare) busybox kill -9 "$pid" 2>/dev/null && k=$((k + 1)) ;;
		esac
	done
	say "kill-after: killed $k processes"
}

# ---- the two orders ---------------------------------------------------------
# Ticket 24's is the second branch and is what every TDX boot before ticket 26
# ran: the workload, then tunneld in the foreground, then poweroff. It puts the
# one thing this guest runs that is not measured at a moment when the ceiling is
# in the kernel and the egress proof has just passed.
#
# Ticket 25's is the first, ported here from docs/snp/image/init.rootfs, and it
# gives up one property deliberately. A sandbox on the adapter has no network of
# its own — --network=none, a loopback-only stack — and its only way out is the
# socket tunneld serves, so tunneld has to exist before it. What replaces "the
# workload ran before anything was attested" is stronger and it is the ticket's
# claim: the workload has no interface, no address and no route, and every byte
# it sends leaves through a name the measured table permitted, to a peer the
# reference value set admitted, under a policy that peer pushed.
#
# The order inside the branch is the order the dependencies run in:
#
#   1. tunneld, in the background, with -sandbox-socket and -self-check. It
#      acquires this guest's evidence, prints it for the record and listens.
#      It is NOT run in the foreground any more and this guest does not power
#      off when it returns: the scenario outlives it, and the console's last
#      line is still this script's EXIT status.
#   2. the socket, waited for rather than slept on. A tunneld that refused to
#      start never creates it, and this loop stops at once on that.
#   3. the exit, which answers a stream a peer opens: it reads the destination
#      off the first line, checks it against the list the config device carries,
#      and dials it. With a socket configured tunneld's own echo stands down, so
#      the exit is the only thing on this guest that answers a peer at all.
#   4. the page the exit will be asked for: busybox httpd on 127.0.0.1:80, out
#      of a directory on /run. It is on loopback and nowhere else, so the segment
#      cannot reach it and the only route to it is this guest's own exit. The
#      body is the image's /srv/index.html plus one line naming this guest, read
#      off the run configuration, because one image boots both guests and a page
#      that could not say which one served it would prove nothing. Beside it is
#      /run/httpd/large, a file of a fixed size generated here from /dev/zero so
#      that a fetch of it takes long enough to still be running when the policy
#      underneath it is replaced. It is generated rather than carried because a
#      file in the image is a file in the measurement, and this one has nothing
#      to say to a verifier.
#   5. the two watchdogs, if the config device asked for them.
#   6. the workload, under runsc, with the adapter's flags.
#   7. what the sentry said, out of the debug log and onto the console.
#   8. tunneld, waited for.
if [ "$ADAPTER" = 1 ]; then
	say "the config device carries a tunnel table; the workload is a sandbox on the adapter (ticket 25)"
	sed 's/^/initrd: tunnel-table: /' "$TUNNEL_TABLE"
	uptime_say
	say "running /usr/bin/tunneld $PUSH -sandbox-socket $SANDBOX_SOCKET -self-check in the background, ahead of the workload"
	/usr/bin/tunneld -config /config -tdx-collateral-dir /config/collateral -self-check \
		$PUSH -sandbox-socket "$SANDBOX_SOCKET" &
	TPID=$!
	i=0
	while [ ! -S "$SANDBOX_SOCKET" ]; do
		busybox kill -0 "$TPID" 2>/dev/null || { say "tunneld exited before $SANDBOX_SOCKET existed; no sandbox can attach"; break; }
		i=$((i + 1))
		[ $i -lt 120 ] || { say "WARNING: $SANDBOX_SOCKET did not appear within 60s"; break; }
		sleep 0.5
	done
	if [ -S "$SANDBOX_SOCKET" ]; then
		say "the sandbox socket is up at $SANDBOX_SOCKET"
		uptime_say
		ALLOW=
		[ -f "$EXIT_ALLOW" ] && ALLOW=$(cat "$EXIT_ALLOW")
		say "running /usr/bin/agent-probe -exit -network socket -sandbox-socket $SANDBOX_SOCKET -allow $ALLOW"
		say "(an empty list refuses every destination, which is the honest default for the place a destination is checked)"
		/usr/bin/agent-probe -exit -network socket -sandbox-socket "$SANDBOX_SOCKET" -allow "$ALLOW" -timeout 30m &
		say "the exit is pid $! (its own lines below say EXIT; it is torn down with the guest)"
	else
		say "not starting the exit: there is no sandbox socket for it to attach to"
	fi

	# The page, and the one line of it that is not in the measurement.
	busybox mkdir -p /run/httpd
	SANDBOX_ID=$(sed -n 's/.*"sandbox_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /config/tunneld.json 2>/dev/null)
	{ cat /srv/index.html; echo "served-by: ${SANDBOX_ID:-unknown}"; } > /run/httpd/index.html
	# The long body. Zeros, because what a fetch of it proves is that it was
	# still arriving when the policy changed and not what it said; its size is
	# fixed here so that the workload can say whether it got all of it.
	LARGE_MIB=8
	dd if=/dev/zero of=/run/httpd/large bs=1048576 count="$LARGE_MIB" 2>/dev/null
	say "httpd large: /run/httpd/large is $(busybox wc -c < /run/httpd/large) bytes of zeros, generated here and in no measurement"
	if busybox httpd -p 127.0.0.1:80 -h /run/httpd; then
		say "busybox httpd is serving /run/httpd on 127.0.0.1:80 (loopback only: the segment cannot reach it)"
	else
		say "WARNING: httpd would not start; a peer asking this guest for the page will get nothing"
	fi
	# Fetched here, by this guest, before the workload exists: it separates "the
	# page is not being served" from "the tunnel did not carry it", which are the
	# two ways the run below can fail and which look alike from the other guest.
	busybox wget -q -O - http://127.0.0.1:80/ 2>&1 | sed 's/^/initrd: httpd says: /'

	NARROW_AFTER=$(knob /config/narrow-after) || NARROW_AFTER=
	if [ -n "$NARROW_AFTER" ] && [ -f /config/push-policy-narrow.json ] && [ -f /config/tunneld-narrow.json ]; then
		say "narrow-after: ${NARROW_AFTER}s from now, a second tunneld will push the narrower policy; this guest's own tunnel is not restarted"
		narrow_later "$NARROW_AFTER" &
	else
		say "no second pusher on this guest (narrow-after, push-policy-narrow.json and tunneld-narrow.json are not all on the config device)"
	fi
	KILL_AFTER=$(knob /config/kill-after) || KILL_AFTER=
	if [ -n "$KILL_AFTER" ]; then
		say "kill-after: ${KILL_AFTER}s from now, the sandbox is killed and its liveness ends"
		kill_later "$KILL_AFTER" &
	else
		say "no kill-after on this guest; the workload ends when it ends"
	fi

	busybox mkdir -p "$RUNSC_DEBUG_DIR"
	run_workload

	# The sentry's account, pulled out of the debug log and put on the console in
	# the order it happened. One line per name the responder answered and one per
	# stream the adapter asked for; that is the whole of what this guest can say
	# about where the workload's bytes went, and without it a fetch that failed
	# would be indistinguishable from a fetch that was refused.
	say "the sentry's own account of the adapter, out of $RUNSC_DEBUG_DIR:"
	grep -h 'tunnel dns:\|tunnel attach:\|tunnel policy:\|exec refused' "$RUNSC_DEBUG_DIR"/* 2>/dev/null \
		| sed 's/^/initrd: sentry: /' \
		|| say "no tunnel lines in the debug log"
	for f in "$RUNSC_DEBUG_DIR"/*; do
		[ -f "$f" ] && say "debug log $f: $(busybox wc -c < "$f") bytes, $(busybox wc -l < "$f") lines"
	done
	if [ "${wrc:-0}" != 0 ]; then
		say "runsc exited $wrc; the tail of each debug log follows"
		for f in "$RUNSC_DEBUG_DIR"/*; do
			[ -f "$f" ] && { say "--- tail of $f"; busybox tail -n 60 "$f" | sed 's/^/initrd: debug: /'; }
		done
	fi

	say "waiting for tunneld (pid $TPID)"
	wait "$TPID"
	rc=$?
else
	run_workload
fi

# Every writable mount that is executable, listed rather than assumed, as
# docs/snp/image/init.rootfs does. The initramfs itself is the honest
# exception and is named as one: it is a tmpfs, so it is writable, and every
# byte of it is inside RTMR2, so writing to it changes nothing a verifier
# already read. It is remounted read-only anyway, because a property that can
# be enforced should not be argued.
mount -o remount,ro / 2>/dev/null \
	&& say "the initramfs is remounted read-only" \
	|| say "the initramfs could not be remounted read-only; it is measured whole either way"
sed 's/^/initrd: mount: /' /proc/mounts

# ---- 9. tunneld -----------------------------------------------------------
# On the adapter path tunneld has already run and has already been waited for:
# step 8 starts it first, because the sandbox beside it has to have something to
# attach to, and $rc is what it exited with. Only ticket 24's order reaches the
# foreground run below, and that is the one difference ticket 26 makes to this
# step. The last line is the same line either way, because it is the line the
# console watchers stop on (docs/snp/cloud/tdx/smoke-tdx-guest.sh,
# run-tdx-scenario.sh: '^initrd: EXIT status=').
if [ "$ADAPTER" != 1 ]; then
	uptime_say
	say "starting tunneld"
	tunneld -config /config -tdx-collateral-dir /config/collateral -self-check
	rc=$?
fi
say "tunneld exited with status ${rc:-0}"
say "EXIT status=${rc:-0}"
sync
poweroff -f
