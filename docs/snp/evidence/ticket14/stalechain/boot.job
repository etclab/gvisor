# Ticket 14: launch the two guests of stalechain.
#
# Privileged only because an SNP launch opens /dev/sev. Both guests are started
# from this one job and waited for together: they are two halves of one
# conversation, and a runner that ran them one after another would have each
# talking to nobody.
set -u
A_LOG="/home/pniroula/Projects/gvisor-ticket14/.scratch/attested-secure-tunnel/host-stack/ticket14-refusals/stalechain/console-a.txt"
B_LOG="/home/pniroula/Projects/gvisor-ticket14/.scratch/attested-secure-tunnel/host-stack/ticket14-refusals/stalechain/console-b.txt"
timeout 240 bash "/home/pniroula/Projects/gvisor-ticket14/docs/snp/tunnel-guest.sh" -image "/home/pniroula/Projects/gvisor-ticket14/.scratch/attested-secure-tunnel/host-stack/image-ticket14" -config "/home/pniroula/Projects/gvisor-ticket14/.scratch/attested-secure-tunnel/host-stack/ticket14-refusals/stalechain/config-a.img" \
    -relay 127.0.0.1:15801 -console "$A_LOG" -mac 52:54:00:14:00:0a  &
A=$!
timeout 240 bash "/home/pniroula/Projects/gvisor-ticket14/docs/snp/tunnel-guest.sh" -image "/home/pniroula/Projects/gvisor-ticket14/.scratch/attested-secure-tunnel/host-stack/image-ticket14" -config "/home/pniroula/Projects/gvisor-ticket14/.scratch/attested-secure-tunnel/host-stack/ticket14-refusals/stalechain/config-b.img" \
    -relay 127.0.0.1:15802 -console "$B_LOG" -mac 52:54:00:14:00:0b   &
B=$!
wait $A; echo "guest A qemu exited $?"
wait $B; echo "guest B qemu exited $?"
chown -R 253477:253477 "/home/pniroula/Projects/gvisor-ticket14/.scratch/attested-secure-tunnel/host-stack/ticket14-refusals/stalechain" 2>/dev/null
chmod -R a+rX "/home/pniroula/Projects/gvisor-ticket14/.scratch/attested-secure-tunnel/host-stack/ticket14-refusals/stalechain" 2>/dev/null
