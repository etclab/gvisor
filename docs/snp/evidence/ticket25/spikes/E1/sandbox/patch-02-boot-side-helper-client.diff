+// SPIKE-E1B (ticket 25) — temporary. E3's Spike object again, with the urpc
+// client handed to the netstack package instead of being exercised in place.
+
+package boot
+
+import (
+	"fmt"
+	"sync"
+
+	"golang.org/x/sys/unix"
+	"gvisor.dev/gvisor/pkg/log"
+	"gvisor.dev/gvisor/pkg/sentry/socket/netstack"
+	"gvisor.dev/gvisor/pkg/unet"
+	"gvisor.dev/gvisor/pkg/urpc"
+)
+
+// Spike is the throwaway control object.
+type Spike struct{}
+
+type spikeAttachArgs struct {
+	urpc.FilePayload
+	EchoAddr string
+	Mode     string
+}
+
+type spikeOpenArg struct {
+	Addr string
+}
+
+type spikeOpenResult struct {
+	urpc.FilePayload
+	ID     int64
+	Mapped string
+}
+
+// spikeHelperClient implements netstack.SpikeHelper over the urpc channel.
+type spikeHelperClient struct {
+	mu sync.Mutex
+	c  *urpc.Client
+}
+
+// Open implements netstack.SpikeHelper.Open.
+func (h *spikeHelperClient) Open(addr string) (int, error) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	var r spikeOpenResult
+	if err := h.c.Call("Helper.Open", &spikeOpenArg{Addr: addr}, &r); err != nil {
+		return -1, err
+	}
+	if len(r.Files) != 1 {
+		return -1, fmt.Errorf("Helper.Open(%s): want 1 file, got %d", addr, len(r.Files))
+	}
+	fd, err := unix.Dup(int(r.Files[0].Fd()))
+	r.Files[0].Close()
+	if err != nil {
+		return -1, err
+	}
+	log.Infof("SPIKE-E1B Helper.Open(%s) -> stream %d mapped %s, host fd %d", addr, r.ID, r.Mapped, fd)
+	return fd, nil
+}
+
+// Attach receives the helper channel.
+func (*Spike) Attach(args *spikeAttachArgs, _ *struct{}) error {
+	if len(args.Files) != 1 {
+		return fmt.Errorf("Spike.Attach: want 1 file, got %d", len(args.Files))
+	}
+	fd, err := unix.Dup(int(args.Files[0].Fd()))
+	if err != nil {
+		return fmt.Errorf("Spike.Attach: dup: %w", err)
+	}
+	sock, err := unet.NewSocket(fd)
+	if err != nil {
+		unix.Close(fd)
+		return fmt.Errorf("Spike.Attach: unet.NewSocket: %w", err)
+	}
+	log.Infof("SPIKE-E1B Attach: received one FD, duped to %d, echo=%q mode=%q", fd, args.EchoAddr, args.Mode)
+	netstack.SpikeSetHelper(&spikeHelperClient{c: urpc.NewClient(sock)}, args.Mode == "e1b-started")
+	return nil
+}
