# ENFORCED agent image: same agent, minimal surroundings.
#
# Per rung-0 spec section Mechanism.4 this is a CONTAINMENT measure, not an
# authorization one. Nothing here stops the agent exec'ing what remains -- and the
# Python interpreter necessarily remains, because it is the agent. What is removed is
# the tooling that would reopen channels 1-3: the cloud CLI and the shells that make
# arbitrary pipelines convenient.
#
# Read the exec row of the rung-0 table with that caveat in mind. It is the weakest of
# the five channels and the README says so.
#
# Build context: ladder/common/
FROM python:3.12-slim

COPY fake_agent/fake_agent.py /ladder/fake_agent.py
COPY probes/ /ladder/probes/

# The probe files are baked into the image rather than bind-mounted so that the
# enforced sandbox mounts exactly two host paths -- the scratch dir and the broker
# socket -- and the filesystem claim stays easy to audit.
#
# The enforced agent runs as uid 65534, and COPY preserves the host file mode, so the
# chmod is what keeps the agent readable to a non-root user.
#
# Last RUN in the file: it deletes the very shell executing it. That is safe (the
# binary is already mapped) but no RUN may follow.
RUN chmod -R a+rX /ladder && \
    rm -f /usr/local/bin/awsctl /usr/bin/curl /usr/bin/wget \
          /bin/sh /bin/bash /bin/dash /usr/bin/apt-get /usr/bin/dpkg

ENTRYPOINT ["python3", "/ladder/fake_agent.py"]
