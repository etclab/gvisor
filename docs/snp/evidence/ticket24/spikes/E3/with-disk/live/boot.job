# Launch the two guests of live.
#
# Privileged only because an SNP launch opens /dev/sev. Both guests are started
# from this one job and waited for together: they are two halves of one
# conversation, and a runner that ran them one after another would have each
# talking to nobody.
set -u
# The launcher takes QEMU and the non-verifying firmware from the host stack,
# and the stack is not inside this checkout when the harness runs from a
# worktree. The runner starts every job in an environment of its own, so the
# stack is named here rather than left to tunnel-guest.sh's default, which
# would look for it beside whichever tree this script was read from.
export STACK="/home/pniroula/Projects/gvisor-t24/.scratch/attested-secure-tunnel/host-stack"
A_LOG="/home/pniroula/Projects/gvisor/.scratch/attested-secure-tunnel/host-stack/image-ticket24-run-e3-with/live/console-a.txt"
B_LOG="/home/pniroula/Projects/gvisor/.scratch/attested-secure-tunnel/host-stack/image-ticket24-run-e3-with/live/console-b.txt"
timeout 390 bash "/home/pniroula/Projects/gvisor-t24/docs/snp/tunnel-guest.sh" -image "/home/pniroula/Projects/gvisor/.scratch/attested-secure-tunnel/host-stack/image-ticket24" -config "/home/pniroula/Projects/gvisor/.scratch/attested-secure-tunnel/host-stack/image-ticket24-run-e3-with/live/config-a.img" \
    -relay 127.0.0.1:15801 -console "$A_LOG" -mac 52:54:00:14:00:0a  -workload /tmp/pniroula/claude-253477/-home-pniroula-Projects-gvisor-t24/46c42ff5-b5e8-48d6-a8bb-ba92dda85a78/scratchpad/workload.img &
A=$!
timeout 390 bash "/home/pniroula/Projects/gvisor-t24/docs/snp/tunnel-guest.sh" -image "/home/pniroula/Projects/gvisor/.scratch/attested-secure-tunnel/host-stack/image-ticket24" -config "/home/pniroula/Projects/gvisor/.scratch/attested-secure-tunnel/host-stack/image-ticket24-run-e3-with/live/config-b.img" \
    -relay 127.0.0.1:15802 -console "$B_LOG" -mac 52:54:00:14:00:0b   -workload /tmp/pniroula/claude-253477/-home-pniroula-Projects-gvisor-t24/46c42ff5-b5e8-48d6-a8bb-ba92dda85a78/scratchpad/workload.img &
B=$!
wait $A; echo "guest A qemu exited $?"
wait $B; echo "guest B qemu exited $?"
chown -R 253477:253477 "/home/pniroula/Projects/gvisor/.scratch/attested-secure-tunnel/host-stack/image-ticket24-run-e3-with/live" 2>/dev/null
chmod -R a+rX "/home/pniroula/Projects/gvisor/.scratch/attested-secure-tunnel/host-stack/image-ticket24-run-e3-with/live" 2>/dev/null
