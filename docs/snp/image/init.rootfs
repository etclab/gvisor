#!/bin/sh
# /sbin/init of the measured root filesystem.
#
# Mounts the kernel filesystems (all noexec), loads the report interface
# driver, proves to the console that no writable path is executable, brings
# loopback up, installs the egress ceiling the binary carries, runs the workload
# bundle under runsc if the workload device carried one, runs that binary — with
# the policy to push, if the config device carries one — and proves the ceiling
# held. When it exits the guest powers off: no
# shell is ever spawned (the busybox that runs this script is present, but
# nothing listens and nothing else is run), no getty, nothing else.
#
# Ticket 26 adds two timing knobs to that order and nothing else: a second
# tunneld that pushes a narrower policy at the peer while the first one's tunnel
# is still carrying the sandbox's bytes, and a kill that ends the workload's
# liveness the way a workload that died would. Both are read off the config
# device, both are numbers of seconds, and neither is in the measurement — what
# they move is when this script does something, never what it is allowed to do.
#
# Ticket 25 adds one alternative order, and the config device chooses between
# them by carrying a file or not. With a tunnel table at /config/tunnel-table.json
# the workload is a sandbox on the adapter, so the things it talks to have to
# exist before it starts: tunneld first (in the background, with the sandbox
# socket the adapter's helper dials), then the exit that answers streams a peer
# opens, then the little web server those streams are for, and only then runsc —
# which now carries --tunnel-socket and --tunnel-table as well. Without that file
# nothing changes and this is ticket 24's script line for line.
export PATH=/bin:/sbin:/usr/bin
say() { echo "init: $*"; }
# The boot clock, from /proc/uptime with the shell's own read: no applet, no
# date(1), and the kernel's printk timestamps on the console lines around it say
# the same thing independently. Printed at the check's verdict, on either side of
# the workload, and at tunneld — which is what a boot-time cost is measured from.
uptime_say() { read UP _ < /proc/uptime; say "uptime ${UP}s"; }

exec >/dev/console 2>&1
mount -t proc   -o nosuid,nodev,noexec proc   /proc
mount -t sysfs  -o nosuid,nodev,noexec sysfs  /sys
mount -t tmpfs  -o nosuid,nodev,noexec,mode=755 tmpfs /run
mount -t tmpfs  -o nosuid,nodev,noexec,mode=1777 tmpfs /tmp
mount -t configfs -o nosuid,nodev,noexec configfs /sys/kernel/config

say "kernel $(cat /proc/sys/kernel/osrelease)"
dmesg | grep -E 'SEV|Memory Encryption' | sed 's/^/init: dmesg: /'

# The report interface (ticket 01's by-hand evidence path) lives on
# /sys/kernel/config/tsm/report once these load. On a non-confidential boot
# sev-guest refuses with "No such device", which is itself a diagnostic.
insmod /lib/modules/tsm_report.ko || say "tsm_report did not load"
insmod /lib/modules/sev-guest.ko  && say "sev-guest loaded: report interface at /sys/kernel/config/tsm/report" \
                                  || say "sev-guest did not load (expected on a non-confidential boot)"

# Every mount that is writable must be noexec. Listed, not assumed.
bad=0
while read -r dev mnt type opts rest; do
  case ",$opts," in
    *,rw,*) case ",$opts," in
              *,noexec,*) ;;
              *) say "WRITABLE AND EXECUTABLE: $mnt ($type,$opts)"; bad=1 ;;
            esac ;;
  esac
done < /proc/mounts
sed 's/^/init: mount: /' /proc/mounts
if [ $bad != 0 ]; then
  # A guest that could diverge from what was measured must not run tunneld.
  say "FATAL: writable executable path present; powering off without running tunneld"
  sync
  poweroff -f
fi
say "no writable path is executable"
uptime_say

# Loopback, before the ceiling and before anything that could be refused.
#
# It is not a convenience. The ceiling's output chain ends in rejects rather
# than in its drop policy so that a socket learns at once that a rule refused
# it, and netfilter delivers the refusal it builds — a TCP reset, an ICMP
# "administratively prohibited" — back at the local socket over lo. With lo
# down that refusal is dropped on the way back and the attempt reads as a
# timeout, which is what a black hole, a missing route and a firewall all look
# like (attest/cmd/tunneld/egress.go, attest/ceiling/ceiling.nft). Measured
# rather than assumed, in a namespace addressed like this guest: with lo down
# the two TCP probes below time out and with it up all four are refused.
#
# lo carries nothing between the guests — the segment is eth0, which tunneld
# brings up out of the run configuration — so this widens nothing. The ceiling
# accepts lo in both directions and always has.
# The netfilter modules the ceiling is installed through, in dependency order.
# There is no modprobe in this guest and the kernel's request_module has no
# userspace helper to call, so each one is named and loaded here. Without them
# the install below fails with "socket: protocol not supported" and this guest
# powers off rather than running with no ceiling at all.
for m in nfnetlink nf_tables nf_reject_ipv4 nf_reject_ipv6 nft_reject nft_reject_inet; do
  insmod "/lib/modules/$m.ko" || say "WARNING: $m.ko did not load; the ceiling will not install"
done
say "netfilter loaded: nf_tables, and the reject expressions the ceiling's output chain ends in"

say "bringing loopback up (the kernel delivers a rule's refusal to the local socket over it)"
ip link set lo up || say "WARNING: loopback would not come up; a refused attempt will read as a timeout"

# The egress ceiling, before tunneld and therefore before the link: tunneld
# brings its own interface up out of the run configuration, so this is the last
# moment at which nothing in this guest can address a packet. The rule set is a
# constant inside the binary and inside the measurement with it (attest/ceiling,
# attest/cmd/tunneld/egress.go) — it reads no file, takes no argument and names
# no peer, so it needs neither the config device nor the author key. It went in
# after the config device was read until ticket 22, because it was generated
# from the signed policy that lived there.
#
# A ceiling that will not install is a guest that would run unconstrained, so
# this powers off rather than continuing. It needs the nf_tables modules loaded
# above; if a build of this image drops one of them, this is where that shows,
# as "socket: protocol not supported".
say "installing the egress ceiling this image carries"
if ! /usr/bin/tunneld -egress install; then
  say "FATAL: the egress ceiling would not install; powering off without running tunneld"
  sync
  poweroff -f
fi

# ---- the workload, under runsc (tickets 24 and 25) -------------------------
# After the ceiling, always: until the ceiling is in the kernel a guest that
# could address a packet is a guest running unconstrained. Whether it is also
# before tunneld is the question the two orders at the bottom of this file
# answer, and the answer is the config device's. Without a tunnel table the
# workload runs before tunneld, which is the one moment at which something can
# run with the ceiling installed and no link for it to leave by (ticket 24);
# with one it runs after, because the adapter it is given *is* tunneld
# (ticket 25).
#
# The bundle comes off the workload device the initrd mounted at /workload
# (ro,exec,nosuid,nodev), which is outside the launch measurement. What is
# measured is this binary, this flag set and that mount's options — never what
# the disk carried.
#
# The namespace: runsc rootless wants a user namespace with a uid mapping it may
# write, and inside one it needs no host capability at all (spike S1, README's
# "Capabilities" section). busybox's unshare makes it — -U -r maps this init's
# root to root inside it, -m -n -p are the namespaces runsc builds on, and -f is
# needed because unsharing a PID namespace only takes effect for a child. The
# fresh procfs is for that new PID namespace: runsc re-execs /proc/self/exe and
# mounts by /proc/self/fd, and the /proc this init mounted belongs to the old
# one. It is mounted nosuid,nodev,noexec like every other writable mount here,
# and inside the mount namespace unshare made, so it is not in init's table.
#
# --root is on /run, which is rw,noexec: the state directory holds a lock and
# metadata, runsc creates it itself, and --gofer-network-namespace=new is what
# keeps runsc from bind-mounting an nsfs rw into it — the one mount that would
# make the check above fatal (spike S1, E2 and E3).
#
# Ticket 25: two flags more, and only when the config device asked for them.
# --tunnel-socket names the AF_UNIX socket tunneld serves the sandbox contract
# on and --tunnel-table the file that says which names the sandbox may reach and
# through which peer. Both or neither, and with them --network=none is required
# — which it already is, and is what makes the adapter the sandbox's only way
# out. The socket is a *pathname* socket on /run and that is load-bearing: the
# driver below copies the mount namespace and makes a fresh network namespace,
# and a pathname socket is reachable across both (only an abstract one is
# per-network-namespace), so the helper runsc spawns inside those namespaces
# reaches the tunneld outside them by the same path. /run is rw,noexec and a
# socket is not an exec, so the rule above has nothing to say about it.
#
# And the sentry's own account of what it did, which is the only diagnostic this
# guest has. The adapter's two interesting lines — `tunnel dns:` for a name it
# resolved or refused, `tunnel attach:` for a stream it asked tunneld for and
# what came back — are debug-level, so they exist only with --debug. They are
# written to files under /run rather than to the console, because --debug on the
# console is tens of thousands of lines on a serial port and would bury the
# workload's own output; the adapter branch below picks those lines back out
# afterwards and puts just them on the console. /run is rw,noexec and a log file
# is not an exec, so the rule above has nothing to say about this either.
SANDBOX_SOCKET=/run/tunneld/sandbox.sock
TUNNEL_TABLE=/config/tunnel-table.json
EXIT_ALLOW=/config/exit-allow
RUNSC_DEBUG_DIR=/run/runsc-debug
RUNSC_FLAGS="--root=/run/runsc-state --platform=systrap --network=none --ignore-cgroups --rootless --gofer-network-namespace=new"
ADAPTER=0
if [ -f "$TUNNEL_TABLE" ]; then
  ADAPTER=1
  RUNSC_FLAGS="$RUNSC_FLAGS --tunnel-socket=$SANDBOX_SOCKET --tunnel-table=$TUNNEL_TABLE"
  RUNSC_FLAGS="$RUNSC_FLAGS --debug --debug-log=$RUNSC_DEBUG_DIR/"
fi
RUNSC_CMD="/usr/bin/runsc $RUNSC_FLAGS run --bundle /workload workload"

# run_workload is ticket 24's block, unmoved and unchanged, in a function so
# that the two orders below both run exactly it and neither has a copy.
run_workload() {
  if [ -f /workload/config.json ]; then
    say "the workload device carries a bundle at /workload/config.json"
    say "running: unshare -Urmnpf sh -c 'mount -t proc -o nosuid,nodev,noexec proc /proc; exec $RUNSC_CMD'"
    uptime_say
    unshare -Urmnpf sh -c "mount -t proc -o nosuid,nodev,noexec proc /proc; exec $RUNSC_CMD"
    wrc=$?
    uptime_say
    say "workload exited with status $wrc"
    # The mount table again, and for a different question than the check's. The
    # check is not re-run and is not moved: it ran before anything else and its
    # verdict is what decided this boot. This is the second question — whether
    # anything runsc made is visible in init's own mount namespace — and the
    # answer should be nothing at all, because unshare gave it a mount namespace
    # of its own and --gofer-network-namespace=new is the one mount that would
    # otherwise have landed outside it.
    sed 's/^/init: mount-after-workload: /' /proc/mounts
  else
    say "no workload bundle at /workload/config.json; continuing to tunneld"
  fi
}

# A policy to push, if the config device carries one (ticket 22,
# docs/policy-push.md). The file is looked for rather than named
# unconditionally, because no policy is the ordinary case — it is what every
# scenario recorded before ticket 22 runs — and a tunneld handed a path it
# cannot read refuses to start.
#
# The name is deliberately not policy.json. That document and its signature are
# what ticket 22 took OFF the config device, and tunneld refuses to start on a
# device carrying either half of it. This is a different document with a
# different life: nothing here loads it, parses it or enforces it. It is handed
# to a peer over a tunnel that peer was already admitted on, and what makes it
# trustworthy there is the evidence this guest presented — not the disk it was
# read from, which is the host's and is not measured.
PUSH=
if [ -f /config/push-policy.json ]; then
  PUSH="-push-policy /config/push-policy.json"
  say "the config device carries a policy to push: /config/push-policy.json"
fi

# ---- ticket 26's two watchdogs, and what each one is for -------------------
#
# A number off the config device, or nothing. The file is read rather than
# sourced and its contents are checked against the shape a number has before
# they reach a command line: nothing on that device may execute, and a shell
# that ran it would be doing exactly that. Zero and absent mean the same thing,
# which is "not set", so that a device can carry every knob and turn one off.
#
# Every knob here is a TIMING knob and none of them is measured. The ceiling is
# compiled into the binary, the runsc flag set is above, and the policy the
# sandbox ends up under is decided by the peer that pushed it and by the sentry
# that judged the subset. A host that changed one of these numbers would change
# how long a recording lasts and nothing else, and a reader of the console can
# see the number this boot used, because it is printed beside what it did.
knob() { # FILE
  [ -f "$1" ] || return 1
  # busybox tr and the shell's own echo: tr is not one of this image's applet
  # symlinks (build-image.sh's ROOT_APPLETS) and printf is not guaranteed to be
  # one either, and neither is worth a new entry in the measurement.
  v=$(busybox tr -d ' \r\n\t' < "$1" 2>/dev/null)
  case "$v" in '' | *[!0-9]*) say "WARNING: $1 is not a number ('$v'); ignoring it"; return 1 ;; esac
  [ "$v" != 0 ] || return 1
  echo "$v"
}

# narrow_later starts a SECOND tunneld that pushes a narrower policy at the peer
# while the first one's tunnel is still carrying the sandbox's bytes. It is a
# second process rather than a restart of the first, and that is the whole
# design: a restart would take this guest's tunnel down with it, and the claim
# under test is that a policy can be replaced with the workload running.
#
# The two share this guest's documents through -config /config and differ in one
# file: -run names a second run configuration on the same device, whose `listen`
# is empty so that it binds no port the first tunneld holds
# (attest/cmd/tunneld/runconfig.go: an empty listen is the one the ceiling has
# no opinion about, and package tunneld takes 127.0.0.1:0 for it), and whose
# `exercise` names the peer to dial. The dial is what makes a push happen at all
# — a push goes to every peer this tunneld dials — and quic.DialAddr opens its
# own socket, so the second tunneld reaches the peer under exactly the rules the
# first one does. It carries NO `link` section: this guest's interface is
# already up, brought up by the first tunneld out of its own run configuration,
# and a second one asking for the same address would fail.
#
# Its exchange is expected to fail and says nothing. The push lands when the
# tunnel is established and before anything is sent over it; what answers a
# stream on the far side is that guest's exit, which holds a list of
# destinations and will not find this payload in it.
narrow_later() { # SECONDS
  sleep "$1"
  say "narrow-after: $1s elapsed; starting a second tunneld to push /config/push-policy-narrow.json at the peer"
  uptime_say
  /usr/bin/tunneld -run /config/tunneld-narrow.json -push-policy /config/push-policy-narrow.json &
  say "narrow-after: the second tunneld is pid $! (its lines say tunneld: like the first one's)"
}

# kill_later ends the workload's liveness the way a workload that died would. It
# kills the sandbox rather than asking it to stop: the point is that nothing
# inside cooperated. The sentry goes, the helper's link to it ends, the helper
# closes its tunneld client, and the tunneld beside it stops hearing the pulse
# that says which policy is in force — which is the contract's liveness rule and
# the reason ticket 23's "apply then ack" was not enough.
#
# Processes are found by name in this init's own /proc rather than by pid,
# because the workload runs behind `unshare -f`: the process this script would
# have a pid for is unshare, and the one that is init of the new PID namespace
# is its child. A PID namespace is visible from its parent, so every process the
# sandbox is made of is in this table under a pid of this namespace's.
#
# The name that is matched is argv[0] out of /proc/PID/cmdline, and NOT comm,
# which is what this script read until the third boot pair of ticket 26 printed
# the table it was matching against: `unshare(183) runsc(184)`, and nothing else.
# The sentry, the gofer and the tunnel helper are all started by re-execing
# /proc/self/exe with a recognisable argv[0] set afterwards, so the kernel's comm
# for each of them is `exe` — runsc/container/container.go:1486 says so in as
# many words ("Otherwise it's shown as `exe`") — and `runsc-sandbox`,
# `runsc-gofer` and `runsc-tunnel-helper` are only in cmdline. A scan matching
# comm therefore reached the foreground `runsc run` and missed the three
# processes that matter, the helper above all: the helper is the sandbox's end of
# tunneld's socket, and its death is the contract's teardown. Two recorded boot
# pairs killed the foreground process, left the helper running, and recorded no
# teardown at all (docs/snp/evidence/ticket26/snp/run, run-2, run-3).
#
# The table is read in full before anything is signalled, and read again
# afterwards, which the first version of this did not do and which two recorded
# boots say the cost of. That version walked /proc killing as it went, and both
# guests printed `killed 1 processes`: the first signal took the foreground runsc
# down, every /proc entry the walk had not reached yet changed under it, and the
# count it printed said nothing about what was still alive. On guest B the line
# arrived a hundred and fifty seconds late and on guest A it never arrived at
# all, so the socket whose closing is the contract's teardown closed at the end
# of the run or not before the power-off (docs/snp/evidence/ticket26/snp/run and
# run-2). What this ticket is trying to time is the delay between a workload
# dying and the tunnel beside it going, and a killer that cannot say when it
# finished cannot be the clock for it. So: collect, print what the sandbox is
# made of, signal it all, and look again — up to three rounds, each with the
# uptime beside it, and a last line that says the table is clear.
kill_later() { # SECONDS
  sleep "$1"
  say "kill-after: $1s elapsed; killing the sandbox, so that nothing inside it gets to say goodbye"
  uptime_say
  r=1
  while [ "$r" -le 3 ]; do
    pids=; names=
    for p in /proc/[0-9]*; do
      pid=${p#/proc/}
      a0=$(tr '\0' '\n' < "$p/cmdline" 2>/dev/null | sed -n 1p) || continue
      case "$a0" in runsc*|/usr/bin/runsc*|unshare*) pids="$pids $pid"; names="$names $a0($pid)" ;; esac
    done
    [ -n "$pids" ] || break
    say "kill-after: round $r, the sandbox in this table is$names"
    k=0
    for pid in $pids; do kill -9 "$pid" 2>/dev/null && k=$((k+1)); done
    say "kill-after: round $r killed $k processes"
    uptime_say
    sleep 1
    r=$((r+1))
  done
  say "kill-after: nothing of the sandbox is left in this init's process table"
  uptime_say
}

# ---- the two orders ---------------------------------------------------------
# Ticket 24's is the second branch and is what every scenario recorded before
# ticket 25 runs: the workload, then tunneld in the foreground. It puts the one
# thing this guest runs that is not measured at the one moment when the ceiling
# is in the kernel and there is no link to leave by, because tunneld is what
# brings eth0 up out of the run configuration.
#
# Ticket 25's is the first, and it gives that property up deliberately and says
# so. A sandbox on the adapter has no network of its own — --network=none, a
# loopback-only stack — and its only way out is the socket tunneld serves, so
# tunneld has to exist before it. The link is therefore up while the workload
# runs. What replaces the old property is a stronger one and it is the ticket's
# claim: the workload has no interface, no address and no route, and every byte
# it sends leaves through a name the measured table permitted and a peer the
# reference value set admitted.
#
# The order inside the branch is the order the dependencies run in:
#
#   1. tunneld, in the background, with -sandbox-socket. It brings up eth0,
#      acquires this guest's evidence and listens; nothing before this can talk.
#   2. the socket, waited for rather than slept on. A tunneld that refused to
#      start (a control boot has no report interface) never creates it, and this
#      loop stops at once on that rather than after the timeout.
#   3. the exit, which is what answers a stream a peer opens: it reads the
#      destination off the first line, checks it against the list the config
#      device carries, and dials it. With a socket configured tunneld's own echo
#      stands down, so the exit is the only thing on this guest that answers a
#      peer at all (attest/cmd/tunneld/nullsandbox.go).
#   4. the page the exit will be asked for: busybox httpd on 127.0.0.1:80, out
#      of a directory on /run. It is on loopback and nowhere else, so the segment
#      cannot reach it and the only route to it is this guest's own exit. The
#      body is the image's /srv/index.html plus one line naming this guest, read
#      off the run configuration, because one image boots both guests and a page
#      that could not say which one served it would prove nothing.
#   5. the workload, under runsc, with the two flags.
#   6. tunneld again — waited for, exactly as the other branch waits for it by
#      running it in the foreground.
if [ "$ADAPTER" = 1 ]; then
  say "the config device carries a tunnel table; the workload is a sandbox on the adapter (ticket 25)"
  sed 's/^/init: tunnel-table: /' "$TUNNEL_TABLE"
  uptime_say
  say "running /usr/bin/tunneld $PUSH -sandbox-socket $SANDBOX_SOCKET in the background, ahead of the workload"
  /usr/bin/tunneld $PUSH -sandbox-socket "$SANDBOX_SOCKET" &
  TPID=$!
  i=0
  while [ ! -S "$SANDBOX_SOCKET" ]; do
    kill -0 "$TPID" 2>/dev/null || { say "tunneld exited before $SANDBOX_SOCKET existed; no sandbox can attach"; break; }
    i=$((i+1))
    [ $i -lt 60 ] || { say "WARNING: $SANDBOX_SOCKET did not appear within 30s"; break; }
    sleep 0.5
  done
  if [ -S "$SANDBOX_SOCKET" ]; then
    say "the sandbox socket is up at $SANDBOX_SOCKET"
    uptime_say
    ALLOW=
    [ -f "$EXIT_ALLOW" ] && ALLOW=$(cat "$EXIT_ALLOW")
    say "running /usr/bin/agent-probe -exit -network socket -sandbox-socket $SANDBOX_SOCKET -allow $ALLOW"
    say "(an empty list refuses every destination, which is the honest default for the place a destination is checked)"
    /usr/bin/agent-probe -exit -network socket -sandbox-socket "$SANDBOX_SOCKET" -allow "$ALLOW" -timeout 30m &
    say "the exit is pid $! (its own lines below say EXIT; it is torn down with the guest)"
  else
    say "not starting the exit: there is no sandbox socket for it to attach to"
  fi

  # The page, and the one line of it that is not in the measurement.
  mkdir -p /run/httpd
  SANDBOX_ID=$(sed -n 's/.*"sandbox_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /config/tunneld.json 2>/dev/null)
  { cat /srv/index.html; echo "served-by: ${SANDBOX_ID:-unknown}"; } > /run/httpd/index.html
  # The long body (ticket 26). Zeros, because what a fetch of it proves is that
  # it was still arriving when the policy under it was replaced and not what it
  # said; its size is fixed here so that the workload can say whether it got all
  # of it, and it is generated rather than carried because a file in the image
  # is a file in the measurement and this one has nothing to say to a verifier.
  # /run is a tmpfs, so this costs eight mebibytes of this guest's memory and
  # nothing on any disk.
  LARGE_MIB=8
  busybox dd if=/dev/zero of=/run/httpd/large bs=1048576 count="$LARGE_MIB" 2>/dev/null
  say "httpd large: /run/httpd/large is $(wc -c < /run/httpd/large) bytes of zeros, generated here and in no measurement"
  if httpd -p 127.0.0.1:80 -h /run/httpd; then
    say "busybox httpd is serving /run/httpd on 127.0.0.1:80 (loopback only: the segment cannot reach it)"
  else
    say "WARNING: httpd would not start; a peer asking this guest for the page will get nothing"
  fi
  # Fetched here, by this guest, before the workload exists: it separates "the
  # page is not being served" from "the tunnel did not carry it", which are the
  # two ways the run below can fail and which look alike from the other guest.
  wget -q -O - http://127.0.0.1:80/ 2>&1 | sed 's/^/init: httpd says: /'

  NARROW_AFTER=$(knob /config/narrow-after) || NARROW_AFTER=
  if [ -n "$NARROW_AFTER" ] && [ -f /config/push-policy-narrow.json ] && [ -f /config/tunneld-narrow.json ]; then
    say "narrow-after: ${NARROW_AFTER}s from now, a second tunneld will push the narrower policy; this guest's own tunnel is not restarted"
    narrow_later "$NARROW_AFTER" &
  else
    say "no second pusher on this guest (narrow-after, push-policy-narrow.json and tunneld-narrow.json are not all on the config device)"
  fi
  KILL_AFTER=$(knob /config/kill-after) || KILL_AFTER=
  if [ -n "$KILL_AFTER" ]; then
    say "kill-after: ${KILL_AFTER}s from now, the sandbox is killed and its liveness ends"
    kill_later "$KILL_AFTER" &
  else
    say "no kill-after on this guest; the workload ends when it ends"
  fi

  mkdir -p "$RUNSC_DEBUG_DIR"
  run_workload

  # The sentry's account, pulled out of the debug log and put on the console in
  # the order it happened. One line per name the responder answered and one per
  # stream the adapter asked for, with the verdict and the time it took; that is
  # the whole of what this guest can say about where the workload's bytes went,
  # and without it a fetch that failed would be indistinguishable from a fetch
  # that was refused (docs/snp/evidence/ticket25/adapter-check/notes.md).
  say "the sentry's own account of the adapter, out of $RUNSC_DEBUG_DIR:"
  grep -h 'tunnel dns:\|tunnel attach:\|tunnel policy:\|exec refused' "$RUNSC_DEBUG_DIR"/* 2>/dev/null \
    | sed 's/^/init: sentry: /' \
    || say "no tunnel lines in the debug log"
  for f in "$RUNSC_DEBUG_DIR"/*; do
    [ -f "$f" ] && say "debug log $f: $(wc -c < "$f") bytes, $(wc -l < "$f") lines"
  done
  # Only when runsc itself failed, because then the lines above will be missing
  # and the reason is in what the sentry said as it died.
  if [ "${wrc:-0}" != 0 ]; then
    say "runsc exited $wrc; the tail of each debug log follows"
    for f in "$RUNSC_DEBUG_DIR"/*; do
      [ -f "$f" ] && { say "--- tail of $f"; tail -n 60 "$f" | sed 's/^/init: debug: /'; }
    done
  fi

  say "waiting for tunneld (pid $TPID)"
  wait "$TPID"
  rc=$?
else
  run_workload
  uptime_say
  say "running /usr/bin/tunneld $PUSH"
  /usr/bin/tunneld $PUSH
  rc=$?
fi
say "tunneld exited with status $rc"

# ---- the proof that the ceiling held --------------------------------------
# The probe attempts the egress the ceiling forbids and reports the errno, so
# that "nothing left this guest" is told apart from "nothing was tried": EACCES
# or EPERM is a rule refusing, ENETUNREACH is the routing table having nothing
# to say, and the probe says as much itself on every line it writes.
#
# It runs here, after tunneld has exited, and that is the one thing about this
# guest that differs from docs/snp/cloud/tdx/init.tdx, where the probe is step
# 6. On TDX the initrd stands the link up itself and can prove the ceiling
# before the workload; here tunneld is what brings this guest's link up, out of
# the run configuration on the config device that this script never reads. Ahead
# of tunneld there is no address, so every attempt would fail in the routing
# table without reaching a rule and the transcript would demonstrate nothing.
# The ceiling itself is installed before the link either way, which is the
# property that matters: the window in which this guest is up and unconstrained
# has length zero.
#
# The default route is added for that same reason and for nothing else. Each of
# the four built-in probes names an address off this segment, so the routing
# table has to have something to say about them or the rule is never reached;
# an on-link default route is the smallest thing that says it. Nothing leaves
# on it: the output hook rejects these packets before the kernel ever resolves
# a neighbour, so the segment carries no ARP for any of the four. And it is
# added after the exercise is over, on a guest that powers off in the next
# breath, so it can widen nothing that ran.
say "proving the egress ceiling held, from inside the guest:"
ip route add default dev eth0 2>/dev/null \
  || say "no default route could be added; the attempts below will read as unrouted rather than refused"
/usr/bin/tunneld -egress probe || say "WARNING: the egress probe reached something the ceiling forbids"

say "powering off"
sync
poweroff -f
