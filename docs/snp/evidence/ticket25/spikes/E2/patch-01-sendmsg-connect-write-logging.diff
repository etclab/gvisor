+// spikeAddrString renders a raw sockaddr the way sock.Connect/sock.SendMsg
+// parse it, for the spike's log lines.
+func spikeAddrString(to []byte) string {
+	if len(to) == 0 {
+		return "<no-addr>"
+	}
+	addr, family, err := socket.AddressAndFamily(to)
+	if err != nil {
+		return fmt.Sprintf("<unparsable err=%v raw=%x>", err, to)
+	}
+	return fmt.Sprintf("family=%d addr=%s port=%d", family, addr.Addr.String(), addr.Port)
+}
+
+func spikeEps(s *sock) string {
+	la, lerr := s.Endpoint.GetLocalAddress()
+	ra, rerr := s.Endpoint.GetRemoteAddress()
+	return fmt.Sprintf("local=%s:%d(%v) remote=%s:%d(%v)", la.Addr.String(), la.Port, lerr, ra.Addr.String(), ra.Port, rerr)
+}
