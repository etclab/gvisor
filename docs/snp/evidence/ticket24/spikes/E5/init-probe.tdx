#!/bin/sh
# ############################################################################
# # E5's PROBE. NEVER MEASURED, NEVER BOOTED ON TDX, NOT A FIX CANDIDATE.     #
# # Eight arrangements of the mount namespace, one boot, so that the choice   #
# # between them is made by the kernel and not by an argument.                #
# ############################################################################
# /init of the measured initrd, on a Google Cloud TDX VM (ticket 19).
#
# This is the whole guest. It is not a stepping stone to one: there is no
# switch_root here, no pivot, and Ubuntu's root filesystem — which is on the
# same disk, two partitions away — is never mounted and never runs a line. What
# the provider's image supplies is shim, grub and a kernel; everything above
# that is in the initrd grub measured into RTMR2 before it handed control over,
# and that is the whole of the difference between this file and
# docs/snp/image/init.initrd, which mapped a dm-verity root and switched into
# it. On SEV-SNP the firmware measures kernel, initrd and command line into the
# launch digest, so the initrd could afford to be a loader. Here grub is the
# measurer, and it measures whole files as it opens them
# (docs/tdx-rtmr2-prediction.md): an initrd that carried everything is measured
# in full, and a dm-verity root would add a second mechanism proving something
# the first already proves.
#
# So: the busybox that runs this script, the tunneld this script starts, the
# author's public key tunneld trusts and the kernel modules the provider left
# out of its kernel are all in here, all covered by one SHA-384 that a verifier
# can compute from the disk image without booting it.
#
# Everything this script says goes to the serial console. It is the only
# diagnostic surface a measured guest has (spec, user story 48), it is what
# `gcloud compute instances get-serial-port-output` returns, and every line is
# prefixed `initrd:` so that a transcript can be read apart from the kernel's
# own.
#
# What it does, in order, and why the order is the order:
#
#   1. kernel filesystems, so that everything after this can be observed
#   2. the modules Ubuntu's gcp kernel leaves out: the TDX guest driver (there
#      is no evidence without it), the NIC (there is no peer without it), and
#      nf_tables (there is no policy without it)
#   3. the egress ceiling, installed in the kernel from the constant compiled
#      into tunneld and read back out of the kernel, then printed
#   4. the config device, found and mounted read-only, noexec — it is outside
#      the measurement and nothing on it may run
#   5. the workload device, found and mounted read-only and exec-permitted at
#      /workload — outside the measurement too, and the only mount in this guest
#      that permits exec, which is the one interesting thing about it. Absent or
#      unmountable is a line and the boot goes on (ticket 24)
#   6. the network, from the addressing the config device carries — the address
#      is outside the measurement for the reason ticket 14 gave: two guests that
#      differed in a measured byte would be two images, and the claim this whole
#      design rests on is that they ran the same one
#   7. the egress proof: four or more attempts to reach what the ceiling
#      forbids, each one refused, on the console, before anything is trusted
#   8. the workload the device carried, if it carried one, under runsc in a user
#      namespace (ticket 24)
#   9. tunneld
#
# Step 3 is where it is, and that is ticket 22's doing. It used to sit after the
# network, because the rule set was generated from policy.json and could not be
# installed until the config device had been found, mounted and read. The
# ceiling is a constant in the measured binary now, so it goes in before there
# is an interface to filter — and the window in which a measured guest is
# running and unconstrained has length zero rather than "however long finding a
# disk takes".
#
# Steps 3 and 7 come before step 9 for the same reason: a guest that started
# tunneld first and constrained itself afterwards would be attested and
# unconstrained for exactly as long as the slowest thing in startup.
#
# Step 8 is between them for a third reason. The ceiling is in the kernel by
# then and the egress proof has just shown that it holds, so the workload runs
# with the guest already constrained; and it runs before tunneld, so nothing it
# does can be mistaken for something a peer was talking to.
export PATH=/bin:/sbin:/usr/bin

say() { echo "initrd: $*"; }
# The boot clock, from /proc/uptime with the shell's own read: no applet, no
# date(1), and the kernel's printk timestamps on the console lines around it say
# the same thing independently. Printed at the egress proof, on either side of
# the workload, and at tunneld — which is what a boot-time cost is measured from
# (docs/snp/image/init.rootfs has the same helper for the same reason).
uptime_say() { read UP _ < /proc/uptime; say "uptime ${UP}s"; }
fail() {
	say "FATAL: $*"
	say "halting; nothing further runs in this guest"
	sync
	while :; do sleep 3600; done
}

mount -t devtmpfs -o nosuid,noexec devtmpfs /dev || fail "mount /dev"
exec >/dev/console 2>&1
mount -t proc   -o nosuid,nodev,noexec proc   /proc || fail "mount /proc"
mount -t sysfs  -o nosuid,nodev,noexec sysfs  /sys  || fail "mount /sys"
mount -t tmpfs  -o nosuid,nodev,noexec,mode=755  tmpfs /run || fail "mount /run"
mount -t tmpfs  -o nosuid,nodev,noexec,mode=1777 tmpfs /tmp || fail "mount /tmp"
mount -t configfs -o nosuid,nodev,noexec configfs /sys/kernel/config || fail "mount configfs"

say "======== attested tunnel guest, in the initrd grub measured ========"
say "kernel  $(uname -r) $(uname -m)"
say "cmdline $(cat /proc/cmdline)"
dmesg | grep -iE 'tdx|memory encryption' | sed 's/^/initrd: dmesg: /'

# ---- 2. the modules the provider's kernel leaves out ----------------------
# Every one of these was taken out of the pinned Ubuntu image's own
# /lib/modules by the build (build-tdx-image.sh), never off the build host: a
# module built for another kernel would not load, and a module from another
# kernel is not what a verifier reading this image would find. They are
# decompressed at build time because busybox's insmod does not speak zstd.
#
# Order is dependency order, because there is no modprobe here and nothing
# resolves it for us.
for m in tdx-guest gve nf_tables nf_reject_ipv4 nf_reject_ipv6 nft_reject nft_reject_inet; do
	if [ ! -f "/lib/modules/$m.ko" ]; then
		say "module $m.ko is not in this initrd"
		continue
	fi
	if insmod "/lib/modules/$m.ko"; then
		say "loaded $m"
	else
		say "WARNING: $m did not load"
	fi
done
say "modules now resident: $(cut -d' ' -f1 /proc/modules | sort | tr '\n' ' ')"

# The report interface is what evidence comes out of. tsm_report is built into
# this kernel and the vendor driver is the module just loaded; if the directory
# is missing, tunneld will say so in its own words, but saying it here names
# the cause rather than the symptom.
if [ -d /sys/kernel/config/tsm/report ]; then
	say "report interface present at /sys/kernel/config/tsm/report"
else
	say "WARNING: /sys/kernel/config/tsm/report is absent; this guest has no evidence to present"
fi

# ---- 3. the egress ceiling ------------------------------------------------
# Before the config device, before the link, before anything in this guest can
# address a packet. The rule set is a constant inside tunneld and inside the
# measurement with it (attest/ceiling, attest/cmd/tunneld/egress.go): it takes
# no argument, reads no file, and names no peer, so there is nothing here for
# the config device to contribute and nothing for it to widen. `-egress print`
# writes the same text, and its SHA-256 is the digest this guest presents to
# every peer it meets.
#
# It names the interface by name rather than by index, which is what lets it
# load now: an index is resolved when the rule is loaded and eth0 does not exist
# yet, while a name is compared when a packet arrives (ticket 22, spike E3).
#
# A ceiling that will not install is a guest that would run unconstrained, so
# this is fatal.
say "installing the egress ceiling this image carries, before the link is up:"
tunneld -egress install || fail "the egress ceiling would not install"

# ---- 4. the config device -------------------------------------------------
# Google attaches it as a second persistent disk with --device-name
# attested-config. Inside the guest that name is normally supplied by udev,
# which runs google_nvme_id and asks the namespace over an admin command; there
# is no udev here and there will not be one, so the device is found from what
# the kernel itself exposes. Both ways are tried and the inventory is printed
# either way, because which of them works is a fact about the provider that this
# transcript is the record of.
CONFIG_NAME=attested-config

say "block devices, as this kernel presents them with no udev running:"
for d in /sys/block/*; do
	n=${d##*/}
	case "$n" in loop*|ram*|dm-*) continue ;; esac
	ser=
	for f in "$d/serial" "$d/device/serial"; do
		[ -r "$f" ] && ser=$(tr -d ' \n' < "$f") && break
	done
	say "  /dev/$n sectors=$(cat "$d/size" 2>/dev/null) serial='$ser' wwid='$(cat "$d/wwid" 2>/dev/null)'"
	for p in "$d"/"$n"*; do
		[ -d "$p" ] && say "    partition ${p##*/} sectors=$(cat "$p/size" 2>/dev/null)"
	done
done
for c in /sys/class/nvme/*; do
	[ -r "$c/serial" ] || continue
	say "  nvme controller ${c##*/}: serial='$(tr -d ' \n' < "$c/serial")' model='$(tr -d ' \n' < "$c/model" 2>/dev/null)'"
done

# ext4_label prints the volume label of a whole-device ext4 filesystem, or
# fails if there is not one there. The superblock is at byte 1024; its magic is
# two bytes at +0x38 and its label sixteen bytes at +0x78. Reading it directly
# avoids depending on busybox's blkid having been compiled in, and it cannot
# match the boot disk, whose first sectors are a GPT.
ext4_label() {
	[ "$(dd if="$1" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')" = "53ef" ] || return 1
	dd if="$1" bs=1 skip=1144 count=16 2>/dev/null | tr -d '\0'
}

find_config_dev() {
	# (a) the device name, if the kernel exposes it as an NVMe serial.
	for d in /sys/block/*; do
		n=${d##*/}
		case "$n" in loop*|ram*|dm-*) continue ;; esac
		for f in "$d/serial" "$d/device/serial"; do
			[ -r "$f" ] || continue
			[ "$(tr -d ' \n' < "$f")" = "$CONFIG_NAME" ] && { CFGDEV=/dev/$n; CFGHOW="the NVMe serial"; return 0; }
		done
	done
	# (b) the filesystem label mkconfigdev-tdx.sh wrote, which is the same
	#     name. This is a weaker identifier and it does not need to be a
	#     stronger one: nothing on the config device is trusted, so the worst a
	#     misidentified device can do is fail to mount or fail to parse, and
	#     both of those stop the guest here rather than admitting anybody.
	for d in /sys/block/*; do
		n=${d##*/}
		case "$n" in loop*|ram*|dm-*) continue ;; esac
		l=$(ext4_label "/dev/$n") || continue
		[ "$l" = "$CONFIG_NAME" ] && { CFGDEV=/dev/$n; CFGHOW="the ext4 label"; return 0; }
	done
	return 1
}

CFGDEV= CFGHOW=
i=0
until find_config_dev; do
	i=$((i + 1))
	[ $i -lt 150 ] || fail "no block device is named $CONFIG_NAME, by serial or by label, after 30 seconds"
	sleep 0.2
done
say "config device $CFGDEV found by $CFGHOW"
mount -t ext4 -o ro,noexec,nosuid,nodev "$CFGDEV" /config \
	|| fail "config device $CFGDEV would not mount"
say "config device mounted at /config (ro,noexec,nosuid,nodev); it holds:"
find /config -type f | sort | while read -r f; do
	say "  ${f#/config/}  $(stat -c %s "$f") bytes  $(sha256sum "$f" | cut -c1-16)…"
done

# ---- 5. the workload device -----------------------------------------------
# One OCI bundle: config.json and the rootfs it names, built by
# mkworkloaddev-tdx.sh and attached as a third disk with --device-name
# attested-workload. It is outside the measurement exactly as the config device
# is, and unlike the config device this mount permits exec — which is the one
# interesting thing about it. The gofer that serves the bundle to the sandbox
# bind-mounts that rootfs and remounts it read-only without MS_NOEXEC, and a
# mount made inside a user namespace has that flag locked, so a remount omitting
# it is refused and a noexec source cannot be served at all
# (docs/snp/evidence/spike-s1-runsc-in-guest/E2/notes.md). Read-only is what
# keeps it harmless: it is not a writable executable path, so the rule
# docs/snp/image/init.rootfs enforces would have nothing to say about it.
#
# So what the measurement covers here is the runsc in this initrd, the flag set
# step 8 launches it with and these mount options. What the disk carries is not
# measured and is not claimed to be.
#
# busybox mount takes `exec` as an option word, where it means the absence of
# MS_NOEXEC, and it is passed literally so that the intent is on the console.
# /proc/mounts will show this mount as ro,nosuid,nodev: there is no exec option
# to show, only the noexec that is not there.
#
# A missing or unmountable disk is one line and the boot continues: no workload
# is the ordinary case, and every guest booted before ticket 24 is that one.
WORKLOAD_NAME=attested-workload
# The label is the truncated form on purpose. ext4 stores sixteen bytes of label
# and 'attested-workload' is seventeen characters, so mke2fs writes
# 'attested-workloa' and mkworkloaddev-tdx.sh says so. The NVMe serial carries
# the whole name, which is why it is tried first.
WORKLOAD_LABEL=attested-workloa

find_workload_dev() {
	# (a) the device name, if the kernel exposes it as an NVMe serial. Same
	#     shape as find_config_dev, and same reason: there is no udev here to
	#     turn --device-name into a path.
	for d in /sys/block/*; do
		n=${d##*/}
		case "$n" in loop*|ram*|dm-*) continue ;; esac
		for f in "$d/serial" "$d/device/serial"; do
			[ -r "$f" ] || continue
			[ "$(tr -d ' \n' < "$f")" = "$WORKLOAD_NAME" ] && { WLDEV=/dev/$n; WLHOW="the NVMe serial"; return 0; }
		done
	done
	# (b) the filesystem label, truncated to what ext4 could hold.
	for d in /sys/block/*; do
		n=${d##*/}
		case "$n" in loop*|ram*|dm-*) continue ;; esac
		l=$(ext4_label "/dev/$n") || continue
		[ "$l" = "$WORKLOAD_LABEL" ] && { WLDEV=/dev/$n; WLHOW="the ext4 label"; return 0; }
	done
	return 1
}

# A short bounded wait and then a line, never a failure: the config device's own
# loop has already waited for the kernel to enumerate its namespaces, so this
# should find the disk on the first pass, and if it does not the guest has no
# workload rather than a problem.
WLDEV= WLHOW=
i=0
until find_workload_dev; do
	i=$((i + 1))
	[ $i -lt 15 ] || break
	sleep 0.2
done
if [ -n "$WLDEV" ]; then
	if mount -t ext4 -o ro,exec,nosuid,nodev "$WLDEV" /workload; then
		say "workload device $WLDEV found by $WLHOW, mounted at /workload (ro,exec,nosuid,nodev; not measured); it holds:"
		find /workload -type f | sort | while read -r f; do
			say "  ${f#/workload/}  $(stat -c %s "$f") bytes  $(sha256sum "$f" | cut -c1-16)…"
		done
	else
		say "WARNING: workload device $WLDEV present but would not mount; the boot continues without a workload"
	fi
else
	say "no workload device (NVMe serial $WORKLOAD_NAME, ext4 label $WORKLOAD_LABEL); the boot continues without a workload"
fi

# ---- 6. the network -------------------------------------------------------
# The addressing arrives on the config device, in a file this script parses
# field by field rather than sources: nothing on that device may execute, and a
# shell that ran it would be doing exactly that. Each field is checked against
# the shape it must have before it reaches a command line.
NET_IF= NET_ADDR= NET_PREFIX= NET_GW= NET_MTU=
[ -f /config/network.conf ] || fail "/config/network.conf is absent; this guest has no address"
while IFS='=' read -r k v; do
	v=$(printf '%s' "$v" | tr -d ' \r\t')
	case "$k" in
	interface) NET_IF=$v ;;
	address) NET_ADDR=$v ;;
	prefix) NET_PREFIX=$v ;;
	gateway) NET_GW=$v ;;
	mtu) NET_MTU=$v ;;
	esac
done < /config/network.conf

if [ -z "$NET_IF" ]; then
	for l in /sys/class/net/*; do
		n=${l##*/}
		[ "$n" = lo ] && continue
		NET_IF=$n
		break
	done
	say "network.conf named no interface; using $NET_IF, the only one that is not loopback"
fi
case "$NET_IF" in '' | *[!a-zA-Z0-9_-]*) fail "network.conf: interface '$NET_IF' is not an interface name" ;; esac
case "$NET_ADDR" in '' | *[!0-9.]*) fail "network.conf: address '$NET_ADDR' is not a dotted quad" ;; esac
case "$NET_PREFIX" in '' | *[!0-9]*) fail "network.conf: prefix '$NET_PREFIX' is not a number" ;; esac
case "$NET_GW" in '' | *[!0-9.]*) fail "network.conf: gateway '$NET_GW' is not a dotted quad" ;; esac
case "$NET_MTU" in *[!0-9]*) fail "network.conf: mtu '$NET_MTU' is not a number" ;; esac

[ -d "/sys/class/net/$NET_IF" ] || fail "no interface $NET_IF; the NIC driver did not attach"

# Loopback up, and it is not a formality.
#
# There is no init system in this guest to do it, and a guest whose lo is down
# looks fine right up to the point where it does not. The egress rule set
# refuses what may not leave by making netfilter build a refusal — a TCP reset,
# or an ICMP "administratively prohibited" — addressed back at the local socket
# that tried. The kernel routes that refusal to one of the guest's own
# addresses, which means out through lo and straight back in. With lo down it
# is dropped on the way, connect() never learns anything, and the dial sits
# there until it times out: a transcript reading "timed out" would not have
# shown that a rule refused anything, because a black hole, a missing route and
# a firewall all look like that. This was measured rather than assumed — with
# lo down the TCP probes time out and with it up they are refused in
# microseconds.
ip link set lo up || fail "bringing loopback up"
say "loopback up (the kernel delivers a rule's refusal to the local socket over it)"

ip link set "$NET_IF" up || fail "bringing $NET_IF up"
[ -n "$NET_MTU" ] && { ip link set "$NET_IF" mtu "$NET_MTU" || fail "setting mtu $NET_MTU on $NET_IF"; }
ip addr add "$NET_ADDR/$NET_PREFIX" dev "$NET_IF" || fail "setting $NET_ADDR/$NET_PREFIX on $NET_IF"
# A /32 leaves the gateway off-link, which is how a Google VPC addresses a
# guest: a host route to the gateway first, then the default through it. There
# is no DHCP client here and there will not be one — a guest that learned its
# address from the network would be a guest whose address the network chose.
ip route add "$NET_GW" dev "$NET_IF" || fail "adding the on-link route to $NET_GW"
ip route add default via "$NET_GW" || fail "adding the default route via $NET_GW"
say "link $NET_IF up: $NET_ADDR/$NET_PREFIX mtu $(cat "/sys/class/net/$NET_IF/mtu"), gateway $NET_GW"
ip -o addr show | sed 's/^/initrd: addr: /'
ip route show | sed 's/^/initrd: route: /'

# ---- 7. the proof that it holds ------------------------------------------
# The ceiling went in at step 3, with no interface to filter; this is the first
# moment there is one, so this is where the proof belongs. The probe reads
# nothing either — the gateway is named on the command line because it is the
# one interesting address that is not universal, and it comes from the config
# device with the rest of the addressing.
say "proving the egress ceiling holds, from inside the guest:"
tunneld -egress probe -egress-probe "udp:$NET_GW:53,tcp:$NET_GW:80" \
	|| fail "the egress probe reached something the ceiling forbids"
uptime_say

# ---- 8. the workload, under runsc (ticket 24) -----------------------------
# Here and nowhere else. After the ceiling and after the proof that it holds,
# because a workload that ran before them would run in a guest that could still
# address a packet; and before tunneld, because tunneld is what this guest
# presents itself to a peer with.
#
# The bundle comes off the workload device mounted at /workload
# (ro,exec,nosuid,nodev) at step 5, which is outside the measurement. What is
# measured is this binary, this flag set and that mount's options — never what
# the disk carried.
#
# The namespace: runsc rootless wants a user namespace with a uid mapping it may
# write, and inside one it needs no host capability at all (spike S1, README's
# "Capabilities" section). busybox's unshare makes it — -U -r maps this init's
# root to root inside it, -m -n -p are the namespaces runsc builds on, and -f is
# needed because unsharing a PID namespace only takes effect for a child. The
# fresh procfs is for that new PID namespace: runsc re-execs /proc/self/exe and
# mounts by /proc/self/fd, and the /proc this init mounted belongs to the old
# one, so writing a child's uid_map through it looks up a pid in the wrong
# namespace and the gofer never starts (ticket 24, E1). It is mounted
# nosuid,nodev,noexec like every other writable mount here, and inside the mount
# namespace unshare made, so it is not in this init's table.
#
# --root is on /run, which is rw,noexec: the state directory holds a lock and
# metadata, runsc creates it itself, and --gofer-network-namespace=new is what
# keeps runsc from bind-mounting an nsfs rw into it (spike S1, E2 and E3).
#
# --network=none is what stands between this workload and a link that is, unlike
# the SNP guest's at this point in its boot, already up.
RUNSC_CMD="/usr/bin/runsc --root=/run/runsc-state --platform=systrap --network=none --ignore-cgroups --rootless --gofer-network-namespace=new run --bundle /workload workload"
if [ -f /workload/config.json ]; then
	# THE PROBE. Eight arrangements of the mount namespace, each in a fresh
	# one, each running the identical runsc command out of /run/probe.sh.
	cat > /run/probe.sh <<EOF
mount -t proc -o nosuid,nodev,noexec proc /proc
busybox unshare -U true
echo "initrd: probe: 'unshare -U true' rc=\$?  (clone(CLONE_NEWUSER); EPERM = the kernel says we are in a chroot)"
echo "initrd: probe: /proc/self/root -> \$(busybox readlink /proc/self/root)"
echo "initrd: probe: cwd \$(busybox pwd)"
sed 's/^/initrd: probe: mount: /' /proc/mounts
exec $RUNSC_CMD
EOF
	try() {
		n=$1
		say "======================== arrangement $n ========================"
		busybox rm -rf /run/runsc-state
		shift
		say "  inside unshare -Urmnpf: $*"
		unshare -Urmnpf sh -c "$*"
		say "arrangement $n: unshare returned $?"
	}
	try A-baseline \
		"sh /run/probe.sh"
	try B-bind-root-onto-root \
		"mount --bind / /; sh /run/probe.sh"
	try C-rbind-run-root-chroot \
		"busybox mkdir -p /run/root; mount --rbind / /run/root; cd /run/root; exec busybox chroot . sh /run/probe.sh"
	try D-rbind-move-onto-root-chroot-cwd \
		"busybox mkdir -p /run/root; mount --rbind / /run/root; cd /run/root; mount --move . /; exec busybox chroot . sh /run/probe.sh"
	try E-rbind-root-onto-root-chroot \
		"mount --rbind / /; exec busybox chroot / sh /run/probe.sh"
	try F-rbind-move-onto-root-chroot-slash \
		"busybox mkdir -p /run/root; mount --rbind / /run/root; mount --move /run/root /; exec busybox chroot / sh /run/probe.sh"
	try G-rbind-move-onto-root-no-chroot \
		"busybox mkdir -p /run/root; mount --rbind / /run/root; mount --move /run/root /; sh /run/probe.sh"
	try H-pivot-root-by-init \
		"busybox mkdir -p /run/root; mount --rbind / /run/root; busybox mkdir -p /run/root/oldroot; cd /run/root; busybox pivot_root . oldroot; sh /run/probe.sh"
	say "======================== the probe is done ========================"
else
	say "no workload bundle at /workload/config.json; continuing to tunneld"
fi

# Every writable mount that is executable, listed rather than assumed, as
# docs/snp/image/init.rootfs does. The initramfs itself is the honest
# exception and is named as one: it is a tmpfs, so it is writable, and every
# byte of it is inside RTMR2, so writing to it changes nothing a verifier
# already read. It is remounted read-only anyway, because a property that can
# be enforced should not be argued.
mount -o remount,ro / 2>/dev/null \
	&& say "the initramfs is remounted read-only" \
	|| say "the initramfs could not be remounted read-only; it is measured whole either way"
sed 's/^/initrd: mount: /' /proc/mounts

# ---- 9. tunneld -----------------------------------------------------------
uptime_say
say "starting tunneld"
tunneld -config /config -tdx-collateral-dir /config/collateral -self-check
rc=$?
say "EXIT status=$rc"
sync
poweroff -f
