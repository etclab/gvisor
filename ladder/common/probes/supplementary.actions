# Supplementary probes. Not part of the five-channel claim; they exist to keep the
# rung-0 README honest about the places where the enforcement is softer than the
# headline, and to show the shape of the evidence rather than just its verdict.
#
# Runs under both configs, same as five-channels.actions.

# fs: the writable scratch path. Expected to SUCCEED under both configs -- the lockdown
# is supposed to leave the agent somewhere to work.
probe-fs-write /scratch/agent-notes.txt

# fs: /tmp. Also succeeds under both, which looks like a hole and is not: under runsc
# /tmp is a sentry-internal tmpfs, so the bytes never reach a host path. demo.sh proves
# that separately rather than asking the reader to take it on faith.
probe-fs-write /tmp/ladder-tmpfs-probe

# fs: a host path that the BASELINE config bind-mounts and the ENFORCED one does not.
probe-fs-write /host-workspace/ladder_pwn

# fs: /var/tmp is mode 1777 in the base image, so a denial here cannot be a uid check
# -- it is the read-only root mount and nothing else. The /etc probe above is denied
# earlier, by DAC, because the enforced agent runs as uid 65534; this one isolates the
# mount from the uid.
probe-fs-write /var/tmp/ladder_ro_probe

# exec: a shell. Present in the baseline image, deleted from the enforced one.
probe-exec /bin/sh -c "echo shell-ran"

# broker: a tool the broker does not know. Denied under both configs -- the broker's
# tool table is the enumerated set of world-effects, and it is the same table either
# way. Rung 0 does no per-task narrowing; that is rung 1's job.
call-broker delete_everything
